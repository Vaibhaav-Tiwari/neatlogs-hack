{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tally.dev/schema/tally-config.schema.json",
  "title": "TallyConfig",
  "description": "tally.yaml. Everything about the target repository and the model tiers comes from here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "test", "backlog", "tiers", "ceilings", "budget", "integrations"],
  "properties": {
    "version": { "const": 1 },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "baseBranch"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "baseBranch": { "type": "string", "minLength": 1 },
        "aoProject": { "type": "string", "minLength": 1 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "setupCommand": { "type": "string", "minLength": 1 },
        "timeoutSec": { "type": "integer", "minimum": 1 }
      }
    },
    "backlog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["github-issues", "file"] },
        "issueLabel": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "harness", "model", "provider", "price", "ceilingFraction"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "harness": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputUsdPerMTok", "cachedInputUsdPerMTok", "outputUsdPerMTok"],
            "properties": {
              "inputUsdPerMTok": { "type": "number", "minimum": 0 },
              "cachedInputUsdPerMTok": { "type": "number", "minimum": 0 },
              "outputUsdPerMTok": { "type": "number", "minimum": 0 }
            }
          },
          "ceilingFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bySizeUsd"],
      "properties": {
        "bySizeUsd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["small", "medium", "large"],
          "properties": {
            "small": { "type": "number", "exclusiveMinimum": 0 },
            "medium": { "type": "number", "exclusiveMinimum": 0 },
            "large": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "usd"],
      "properties": {
        "source": { "enum": ["config", "cfoai"] },
        "usd": { "type": "number", "exclusiveMinimum": 0 },
        "cfoai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario"],
          "properties": { "scenario": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "concurrency": { "type": "integer", "minimum": 1 },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neatlogs", "entire", "cfoai", "slack"],
      "properties": {
        "neatlogs": { "type": "boolean" },
        "entire": { "type": "boolean" },
        "cfoai": { "type": "boolean" },
        "slack": { "type": "boolean" }
      }
    }
  }
}
