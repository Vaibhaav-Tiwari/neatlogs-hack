{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tally.dev/schema/ledger-row.schema.json",
  "title": "LedgerRow",
  "description": "One row per attempt. Money is integer nanos of USD (1 USD = 1e9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "runId",
    "taskId",
    "taskTitle",
    "attempt",
    "size",
    "tier",
    "model",
    "harness",
    "sessionId",
    "branch",
    "tokens",
    "estimatedCostNanos",
    "costSource",
    "ceilingNanos",
    "result",
    "resultReason",
    "escalatedFrom",
    "handoff",
    "prUrl",
    "traceId",
    "traceUrl",
    "checkpointId",
    "checkpointUrl",
    "decision",
    "startedAt",
    "endedAt"
  ],
  "properties": {
    "setupDurationMs": { "type": "integer", "minimum": 0 },
    "schemaVersion": { "const": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "taskTitle": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "size": { "enum": ["small", "medium", "large"] },
    "tier": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "minLength": 1 },
    "sessionId": { "type": ["string", "null"] },
    "entireSessionId": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "baseCommit": { "type": ["string", "null"] },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncachedInput", "cachedInput", "output", "total"],
      "properties": {
        "uncachedInput": { "type": "integer", "minimum": 0 },
        "cachedInput": { "type": "integer", "minimum": 0 },
        "cacheWrite5m": { "type": "integer", "minimum": 0 },
        "cacheWrite1h": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "estimatedCostNanos": { "type": "integer", "minimum": 0 },
    "costSource": { "enum": ["list-price", "ao-estimate", "simulated"] },
    "priceNote": { "type": "string" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputUsdPerMTok", "cachedInputUsdPerMTok", "outputUsdPerMTok"],
      "properties": {
        "inputUsdPerMTok": { "type": "number", "minimum": 0 },
        "cachedInputUsdPerMTok": { "type": "number", "minimum": 0 },
        "outputUsdPerMTok": { "type": "number", "minimum": 0 }
      }
    },
    "ceilingNanos": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["passed", "failed", "stopped", "error"] },
    "resultReason": { "type": ["string", "null"] },
    "failureAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "traceId", "evidence", "spans", "retryable", "detail"],
      "properties": {
        "kind": { "enum": ["ceiling", "tool-failure", "tests-failed", "permission-refused", "model-unavailable", "unknown"] },
        "source": { "enum": ["neatlogs", "ledger"] },
        "traceId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{32}$" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "spans": { "type": "array", "items": { "type": "string" } },
        "retryable": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "scopeWarnings": { "type": "array", "items": { "type": "string" } },
    "permissionWarnings": { "type": "array", "items": { "type": "string" } },
    "tallyCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "escalatedFrom": { "type": ["string", "null"] },
    "handoff": { "enum": ["none", "restart", "entire-handoff"] },
    "handoffText": { "type": ["string", "null"] },
    "prUrl": { "type": ["string", "null"], "format": "uri" },
    "traceId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{32}$" },
    "traceUrl": { "type": ["string", "null"], "format": "uri" },
    "workerTraceId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{32}$" },
    "workerTraceUrl": { "type": ["string", "null"], "format": "uri" },
    "workerTraceDetail": { "type": "string", "minLength": 1 },
    "checkpointId": { "type": ["string", "null"] },
    "checkpointUrl": { "type": ["string", "null"], "format": "uri" },
    "decision": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
