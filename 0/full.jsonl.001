,\n    prUrl: latest.prUrl,\n  };\n}\n\nasync function runAttemptWithRetry(input: Parameters<typeof runSingleAttempt>[0]): Promise<LedgerRow> {\n  let row: LedgerRow;\n  try {\n    row = await runSingleAttempt(input);\n  } catch (error) {\n    const modelError = modelAccessConfigurationError(error, input.tier);\n    if (modelError) {\n      if (input.config.modelAccessFallbackTier) return modelAccessFailureRow(input, modelError);\n      throw new ConfigError(input.configPath, [modelError]);\n    }\n    throw error;\n  }\n  if (row.result === 'error' && row.resultReason === 'worker never started' && !(row.tokens?.total) && !input.dryRun) {\n    await input.onStartupError?.(row);\n    try {\n      return await runSingleAttempt({ ...input, retrySuffix: ':startup-retry', continueBranch: row.branch, continueSessionId: row.sessionId });\n    } catch (error) {\n      const modelError = modelAccessConfigurationError(error, input.tier);\n      if (modelError) {\n        if (input.config.modelAccessFallbackTier) return modelAccessFailureRow({ ...input, retrySuffix: ':startup-retry' }, modelError);\n        throw new ConfigError(input.configPath, [modelError]);\n      }\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"https://tally.dev/schema/tally-config.schema.json\",\n  \"title\": \"TallyConfig\",\n  \"description\": \"tally.yaml. Everything about the target repository and the model tiers comes from here.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"version\", \"repo\", \"test\", \"backlog\", \"tiers\", \"ceilings\", \"budget\", \"integrations\"],\n  \"properties\": {\n    \"version\": { \"const\": 1 },\n    \"runner\": { \"enum\": [\"ao\", \"direct\"], \"default\": \"ao\" },\n    \"claudeCode\": {\n      \"type\": \"object\", \"additionalProperties\": false, \"required\": [\"allow\"],\n      \"properties\": { \"allow\": { \"type\": \"array\", \"uniqueItems\": true, \"items\": { \"type\": \"string\", \"minLength\": 1 }, \"minItems\": 1 } }\n    },\n    \"repo\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"path\", \"baseBranch\"],\n      \"properties\": {\n        \"path\": { \"type\": \"string\", \"minLength\": 1 },\n        \"slug\": { \"type\": \"string\", \"pattern\": \"^[^/\\\\s]+/[^/\\\\s]+$\" },\n        \"baseBranch\": { \"type\": \"string\", \"minLength\": 1 },\n        \"aoProject\": { \"type\": \"string\", \"minLength\": 1 },\n        \"aoBin\": { \"type\": \"string\", \"minLength\": 1 },\n        \"workerPublishesPr\": { \"type\": \"boolean\" },\n        \"blockOutOfScopeChanges\": { \"type\": \"boolean\", \"default\": false }\n      }\n    },\n    \"test\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\"],\n      \"properties\": {\n        \"command\": { \"type\": \"string\", \"minLength\": 1 },\n        \"setupCommand\": { \"type\": \"string\", \"minLength\": 1 },\n        \"timeoutSec\": { \"type\": \"integer\", \"minimum\": 1 }\n      }\n    },\n    \"backlog\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"source\"],\n      \"properties\": {\n        \"source\": { \"enum\": [\"github-issues\", \"file\"] },\n        \"issueLabel\": { \"type\": \"string\", \"minLength\": 1 },\n        \"file\": { \"type\": \"string\", \"minLength\": 1 }\n      }\n    },\n    \"tiers\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"name\", \"harness\", \"model\", \"provider\", \"price\", \"ceilingFraction\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"minLength\": 1 },\n          \"harness\": { \"enum\": [\"codex\", \"claude-code\"] },\n          \"sessionMode\": { \"type\": \"string\", \"enum\": [\"chat\", \"tui\"] },\n          \"model\": { \"type\": \"string\"