escribe('Entire onboarding', () => {\n     expect(vi.mocked(f.context.ui.confirm).mock.calls.join('\\n')).not.toContain(';');\n     expect(f.calls.every(call => call.cwd === f.context.repoRoot)).toBe(true);\n   });\n+  it('reports an existing mirror without asking or changing it', async () => {\n+    const f = fixture([true]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    f.state.mirrors = [{ repo: '/gh/acme/widgets', status: 'ready', placements: [{ cluster: 'aws-ap-south-1.entire.io', status: 'ready' }] }];\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    expect(f.calls.some(c => c.args.join(' ') === 'repo mirror add /gh/acme/widgets --timeout 5m')).toBe(false);\n+    expect(vi.mocked(f.context.ui.confirm).mock.calls).toHaveLength(1);\n+    expect(vi.mocked(f.context.ui.print).mock.calls.join(' ')).toContain('Entire mirror ready on aws-ap-south-1.entire.io.');\n+  });\n+  it('asks before creating an Entire mirror and lets the Entire CLI collect region choice', async () => {\n+    const f = fixture([true, true]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    const add = f.calls.find(c => c.args.join(' ') === 'repo mirror add /gh/acme/widgets --timeout 5m');\n+    expect(add?.interactive).toBe(true);\n+    expect(f.calls.some(c => c.args.join(' ') === 'repo view /gh/acme/widgets --json')).toBe(true);\n+    expect(vi.mocked(f.context.ui.confirm).mock.calls[1]![0]).toBe('Mirror this repository in Entire?');\n+    expect(vi.mocked(f.context.ui.print).mock.calls.join(' ')).toContain('Entire mirror ready for acme/widgets.');\n+  });\n+  it('keeps Entire enabled when the user skips the optional mirror', async () => {\n+    const f = fixture([true, false]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    expect(f.state.mirrorAdded).toBe(false);\n+    expect(f.calls.some(c => c.args[0] === 'repo' && c.args[1] === 'mirror' && c.args[2] === 'add')).toBe(false);\n+  });\n   it('keeps Entire off when hook trust is skipped', async () => {\n     const f = fixture([false]);\n     expect((await f.module.configure(f.context)).enabled).toBe(false);\ndiff --git a/onboarding/entire.ts b/onboarding/entire.ts\nindex 73fd23b..9b7208d 100644\n--- a/onboarding/entire.ts\n+++ b/onboarding/entire.ts\n@@ -32,6 +32,26 @@ export interface EntireOnboardingOptions {\n   command?: EntireOnboardingCommand;\n }\n \n+interface EntireMirrorPlacement {\n+  cluster?: unknown;\n+  status?: unknown;\n+}\n+\n+interface EntireMirrorRecord {\n+  repo?: unknown;\n+  status?: unknown;\n+  placements?: EntireMirrorPlacement[];\n+}\n+\n+function mirrorRecords(output: string): EntireMirrorRecord[] {\n+  const parsed: unknown = JSON.parse(output);\n+  if (Array.isArray(parsed)) return parsed as EntireMirrorRecord[];\n+  if (parsed && typeof parsed === 'object' && Array.isArray((parsed as { items?: unknown }).items)) {\n+    return (parsed as { items: EntireMirrorRecord[] }).items;\n+  }\n+  throw new Error('Unreadable Entire mirror status');\n+}\n+\n export class EntireOnboarding implements IntegrationOnboarding {\n   private cwd: string;\n   private readonly command: EntireOnboardingCommand;\n@@ -51,6 +71,48 @@ export class EntireOnboarding implements IntegrationOnboarding {\n   private async status(): Promise<Record<string, unknown>> {\n     return json(await this.run('entire', ['status', '--json']));\n   }\n+  private async ensureMirror(context: OnboardingContext): Promise<string | null> {\n+    const slug = context.config.repo.slug;\n+    if (!slug) return null;\n+    const repoRef = `/gh/${slug}`;\n+    let records: EntireMirrorRecord[];\n+    try {\n+      records = mirrorRecords(await this.run('entire', ['repo', 'mirror', 'list', '--json', '--mirrored', '--name', slug]));\n+    } catch {\n+      const detail = `Could not check Entire mirror status. If you want a browser mirror, run \\`entire repo mirror add ${repoRef}\\` after onboarding.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+    const existing = records.find(record => record.repo === repoRef);\n+    const placements = existing?.placements ?? [];\n+    if (placements.some(placement => placement.status === 'ready')) {\n+      const clusters = placements.filter(placement => placement.status === 'ready')\n+        .map(placement => typeof placement.cluster === 'string' ? placement.cluster : null).filter(Boolean);\n+      const detail = `Entire mirror ready${clusters.length ? ` on ${clusters.join(', ')}` : ''}.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+    context.ui.print('Optional Entire browser mirror');\n+    context.ui.print(`  This creates a copy of ${slug} in Entire so checkpoint sessions can open in its web app.`);\n+    context.ui.print('  The Entire CLI will ask which region or regions should store the copy. You can skip this.');\n+    if (!await context.ui.confirm('Mirror this repository in Entire?')) {\n+      context.ui.print('Entire mirror skipped. Graph sizing and local checkpoint capture remain enabled.');\n+      return 'Entire mirror skipped.';\n+    }\n+    try {\n+      await this.run('entire', ['repo', 'mirror', 'add', repoRef, '--timeout', '5m'], true);\n+      const view = json(await this.run('entire', ['repo', 'view', repoRef, '--json']));\n+      const ready = Array.isArray(view.placements) && view.placements.some(placement =>\n+        !!placement && typeof placement === 'object' && (placement as EntireMirrorPlacement).status === 'ready');\n+      if (!ready) throw new Error('Entire mirror is not ready yet');\n+      context.ui.print(`Entire mirror ready for ${slug}.`);\n+      return 'Entire mirror ready.';\n+    } catch {\n+      const detail = `Entire capture remains enabled, but the mirror could not be verified. Retry with \\`entire repo mirror add ${repoRef}\\`.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+  }\n   async check(): Promise<IntegrationState> {\n     try {\n       await this.run('entire', ['--version']);\n@@ -151,7 +213,8 @@ export class EntireOnboarding implements IntegrationOnboarding {\n       if (required.includes('codex') && !await context.ui.confirm('Have you trusted the Entire hooks via /hooks in Codex for this repository?')) {\n         return off('Codex hook trust is not confirmed. Entire remains off until you trust the hooks.');\n       }\n-      return { enabled: true, state: { status: 'ok', detail: 'Entire login, graph and repository capture are configured. Generated summaries remain off by default.' } };\n+      const mirror = await this.ensureMirror(context);\n+      return { enabled: true, state: { status: 'ok', detail: ['Entire login, graph and repository capture are configured.', mirror, 'Generated summaries remain off by default.'].filter(Boolean).join(' ') } };\n     } catch { return off('Entire setup could not be verified. Any generated files remain for review. No further changes were attempted.'); }\n   }\n }\n","exit_code":0,"duration":{"secs":2,"nanos":860834167},"formatted_output":"Warning: truncated output (original token count: 12350)\nTotal output lines: 810\n\ndiff --git a/README.md b/README.md\nindex 9fd185b..0b5a753 100644\n--- a/README.md\n+++ b/README.md\n@@ -498,10 +498,20 @@ named by its new commits to `origin` and to an `entire` remote when configured.\n Checkpoint upload failures are reported as publishing failures. Dry runs do\n not publish branches or checkpoints.\n \n-Entire documents commit links as\n-`https://entire.io/gh/<org>/<repo>/commit/<commit-sha>`. Tally keeps\n-`checkpointUrl` null unless the CLI returns a URL; a local checkpoint does not\n-by itself establish that a hosted link works.\n+Entire checkpoint records live in separate Git refs, not on the task branch.\n+Tally keeps the checkpoint ID and native session ID, and attaches a clickable\n+Entire session link only when the Entire CLI confirms that the GitHub repo has\n+a ready mirror. The link opens the session that contains the checkpoint; a\n+reviewer still needs access to that repo in Entire. Without a ready mirror,\n+Tally keeps the checkpoint ID available in the local ledger rather than adding\n+a link that may not open.\n+\n+After each run has completed its Neatlogs read-back, Tally adds an evidence\n+section to the generated PR body when links are available: Entire session and\n+checkpoint, Neatlogs routing and worker traces, and the configured cfo.ai\n+budget and spend tables. Worker trace links are added only after Tally verifies\n+their read-back. These dashboard links use the viewer's existing account\n+access; Tally does not publish public trace shares.\n \n Tally assumes nothing about the repository it works on. The repository, test\n command, model tiers, list prices, ceilings and budget all come from\ndiff --git a/adapters/entire-checkpoints.test.ts b/adapters/entire-checkpoints.test.ts\nindex 1de3e8a..0c621e8 100644\n--- a/adapters/entire-checkpoints.test.ts\n+++ b/adapters/entire-checkpoints.test.ts\n@@ -105,6 +105,42 @@ describe('EntireCheckpointAdapter', () => {\n     });\n   });\n \n+  it('builds an Entire session link only when the GitHub repo has a ready mirror', async () => {\n+    const calls: string[] = [];\n+    const adapter = new EntireCheckpointAdapter({ repoPath: '/repo', repoSlug: 'acme/widgets', command: async (_file, args) => {\n+      calls.push(args.join(' '));\n+      if (args[0] === 'log') return { stdout: 'fix: thing\\n\\nEntire-Checkpoint: 01M4LINK\\n', stderr: '' };\n+      if (args[0] === 'checkpoint') return { stdout: JSON.stringify({ checkpoint_id: '01M4LINK', sessions: [{ session_id: 'native-session-1' }] }), stderr: '' };\n+      if (args.join(' ') === 'repo mirror list --json --mirrored --name acme/widgets') return {\n+        stdout: JSON.stringify([{ repo: '/gh/acme/widgets', placements: [{ status: 'ready' }] }]), stderr: '',\n+      };\n+      throw new Error(`unexpected Entire command: ${args.join(' ')}`);\n+    } });\n+    await expect(adapter.checkpointFor({ sessionId: 'worker', branch: 'task' })).resolves.toEqual({\n+      checkpointId: '01M4LINK',\n+      checkpointUrl: 'https://entire.io/gh/acme/widgets/session/native-session-1',\n+      entireSessionId: 'native-session-1',\n+    });\n+    expect(calls).toEqual([\n+      'log -1 --format=%B --end-of-options task --',\n+      'checkpoint explain 01M4LINK --json --no-pager',\n+      'repo mirror list --json --mirrored --name acme/widgets',\n+    ]);\n+  });\n+\n+  it('keeps the URL absent when Entire has no ready mirror for the repository', async () => {\n+    const adapter = new EntireCheckpointAdapter({ repoPath: '/repo', repoSlug: 'acme/widgets', command: async (_file, args) => {\n+      if (args[0] === 'log') return { stdout: 'fix: thing\\n\\nEntire-Checkpoint: 01M4LOCAL\\n', stderr: '' };\n+      if (args[0] === 'checkpoint') return { stdout: JSON.stringify({ checkpoint_id: '01M4LOCAL', sessions: [{ session_id: 'native-session-2' }] }), stderr: '' };\n+      return { stdout: '[]', stderr: '' };\n+    } });\n+    await expect(adapter.checkpointFor({ sessionId: 'worker', branch: 'task' })).resolves.toMatchObject({\n+      checkpointId: '01M4LOCAL',\n+      checkpointUrl: null,\n+      entireSessionId: 'native-session-2',\n+    });\n+  });\n+\n   it('uses the worker branch trailer before an unrelated AO session and retains the native session', async () => {\n     const calls: string[] = [];\n     const adapter = new EntireCheckpointAdapter({ repoPath: '/root', command: async (file, args, options) => {\ndiff --git a/adapters/entire-checkpoints.ts b/adapters/entire-checkpoints.ts\nindex 62f6354..d16a75b 100644\n--- a/adapters/entire-checkpoints.ts\n+++ b/adapters/entire-checkpoints.ts\n@@ -1,6 +1,7 @@\n import { runCommand } from './command.js';\n import { resolve } from 'node:path';\n import type { CheckpointInfo, CheckpointPort, HandoffContext, HandoffPort, HandoffSummary } from '../agent/ports.js';\n+import { entireSessionUrl } from './evidence-links.js';\n \n const execFileAsync = runCommand;\n \n@@ -13,6 +14,7 @@ export type CommandRunner = (file: string, args: string[], options?: { cwd?: str\n \n export interface EntireCheckpointOptions {\n   repoPath: string;\n+  repoSlug?: string;\n   command?: CommandRunner;\n   summaryTimeoutSec?: number;\n   generatedSummaries?: boolean;\n@@ -49,6 +51,11 @@ interface ExplainEnvelope {\n   sessions?: Array<{ session_id?: unknown }>;\n }\n \n+interface MirrorRecord {\n+  repo?: unknown;\n+  placements?: Array<{ status?: unknown }>;\n+}\n+\n interface ResolvedCheckpoint extends CheckpointInfo {\n   branch: string | null;\n   filesTouched: string[];\n@@ -102,12 +109,15 @@ export class EntireCheckpointAdapter implements HandoffPort, CheckpointPort {\n   private readonly repoPath: string;\n   private readonly summaryTimeoutSec: number;\n   private readonly generatedSummaries: boolean;\n+  private readonly repoSlug?: string;\n+  private mirrorReadyPromise?: Promise<boolean>;\n \n   constructor(options: EntireCheckpointOptions) {\n     this.command = options.command ?? defaultCommand;\n     this.repoPath = options.repoPath;\n     this.summaryTimeoutSec = options.summaryTimeoutSec ?? 45;\n     this.generatedSummaries = options.generatedSummaries === true;\n+    this.repoSlug = options.repoSlug;\n   }\n \n   async checkpointFor(context: HandoffContext & { sessionId: string }): Promise<CheckpointInfo | null> {\n@@ -211,12 +221,29 @@ export class EntireCheckpointAdapter implements HandoffPort, CheckpointPort {\n     );\n     const parsed = result ? parseJson<ExplainEnvelope>(result.stdout) : null;\n     const checkpoint = checkpointId(parsed ?? {}) ?? id;\n+    const entireSessionId = text(parsed?.sessions?.[parsed.sessions.length - 1]?.session_id);\n+    const explicitUrl = parsed ? checkpointUrl(parsed) : null;\n+    const hostedUrl = explicitUrl ?? (entireSessionId