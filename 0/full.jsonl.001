{"timestamp":"2026-10-12T19:24:02.596Z","ordinal":16845,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a125af-5d46-7871-9bed-a128df2c2957","turn_id":"01a13190-4b5d-74c2-9db6-6b4f1c0c4022","item":{"type":"CommandExecution","id":"exec-4b8b6e4a-799c-4ad9-bf84-3be5e2b75bb8","process_id":"53111","command":["/bin/zsh","-lc","git diff 03fc2da 8a6ce51 -- engine/init.ts adapters/cfoai.ts engine/real.ts docs/HUMAN_APPROVALS.md"],"cwd":"file:///Users/vaibhaav/.ao/data/worktrees/neatlogs-hack/neatlogs-hack-5","parsed_cmd":[{"type":"unknown","cmd":"git diff 03fc2da 8a6ce51 -- engine/init.ts adapters/cfoai.ts engine/real.ts docs/HUMAN_APPROVALS.md"}],"source":"unified_exec_startup","status":"completed","stdout":"diff --git a/adapters/cfoai.ts b/adapters/cfoai.ts\nindex 9ff939b..fcb0a27 100644\n--- a/adapters/cfoai.ts\n+++ b/adapters/cfoai.ts\n@@ -410,15 +410,16 @@ export class CfoaiBudgetAdapter implements BudgetPort {\n     }\n     try {\n       const result = await this.client.callTool('edit_memory', args);\n-      if (isRecord(result) && result.isError === true) throw new Error('cfo.ai refused the Ari context write');\n+      if (isRecord(result) && result.isError === true) throw new Error(cfoaiRefusalMessage(result));\n       const parsed = unwrapToolResult(result);\n       if (isRecord(parsed) && (parsed.status === 'rejected' || parsed.status === 'error')) {\n-        throw new Error('cfo.ai refused the Ari context write');\n+        throw new Error(cfoaiRefusalMessage(parsed));\n       }\n       this.setOkStatus('Ari task context was shared with organization memory.');\n     } catch (error) {\n       const detail = safeCfoaiError(error);\n-      this.statusState = { status: 'error', detail: `Ari task context write failed: ${detail}` };\n+      // Organization memory is optional reporting; its refusal must not label\n+      // working budget reads and spend-table writes as disconnected.\n       throw new Error(detail);\n     }\n   }\n@@ -536,6 +537,22 @@ function successfulEdit(value: unknown): boolean {\n   return isRecord(parsed) && (parsed.status === 'applied' || (parsed.status === 'no_op' && parsed.reason === 'already_satisfied'));\n }\n \n+function cfoaiRefusalMessage(value: unknown): string {\n+  const parsed = unwrapToolResult(value);\n+  let detail: unknown;\n+  if (typeof parsed === 'string') detail = parsed;\n+  else if (isRecord(parsed)) {\n+    const error = parsed.error;\n+    if (isRecord(error)) {\n+      detail = [error.code, error.message, error.hint].filter((part): part is string => typeof part === 'string').join(': ');\n+    } else detail = parsed.message ?? error ?? parsed.reason ?? parsed.detail;\n+  }\n+  const safeDetail = typeof detail === 'string' ? safeCfoaiError(new Error(detail)) : null;\n+  return safeDetail && safeDetail !== 'cfo.ai returned an unspecified error'\n+    ? `cfo.ai refused the Ari context write: ${safeDetail}`\n+    : 'cfo.ai refused the Ari context write';\n+}\n+\n export function safeCfoaiError(error: unknown): string {\n   return (error instanceof Error ? error.message : String(error))\n     .replace(/\\bBearer\\s+[^\\s,;]+/gi, 'Bearer [redacted]')\n@@ -560,7 +577,7 @@ function supportsOrganizationMemory(schema: Record<string, unknown> | undefined)\n         filename: 'tally-schema-check.md',\n         scope: 'organization',\n         tags: ['tally'],\n-        metadata: { source: 'tally-agents' },\n+        metadata: { producer: 'tally-agents' },\n       },\n     });\n   } catch { return false; }\ndiff --git a/docs/HUMAN_APPROVALS.md b/docs/HUMAN_APPROVALS.md\nindex 8784a6e..3572a91 100644\n--- a/docs/HUMAN_APPROVALS.md\n+++ b/docs/HUMAN_APPROVALS.md\n@@ -14,17 +14,18 @@ The integration choices authorize the actions described in their prompt and summ\n - **Neatlogs history read:** if `NEATLOGS_TOKEN` is already present, init connects read-only history automatically after verifying `NEATLOGS_PROJECT_ID` or asking you to select a project. Use a project-scoped token with `context:read` and `observability:read`. Tally stores credentials outside the repository and reads through the Public API; it does not write history records through this reader. Without valid credentials it uses local history. See Neatlogs' [authentication and scopes](https://docs.neatlogs.com/api-reference/authentication) and [pagination contract](https://docs.neatlogs.com/api-reference/pagination).\n - **Entire login and Graph plugin:** approving login starts Entire's own browser authentication; approving Graph installs its CLI plugin. These are account/machine changes and are independent of Tally's final config write.\n - **Entire CLI installation:** if the Entire CLI is missing and Entire is selected, init offers its official platform installer and requires a separate yes. This installs only the CLI. Login, Graph installation, repository capture, hook trust, settings publication, and a repository mirror remain separate approvals. See [Entire's installation guide](https://docs.entire.io/installation).\n-- **Entire repository capture:** before enabling capture, review the proposed repository files and local Git hooks. A second confirmation is required before Tally commits only the listed settings and pushes them to the repository's default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n+- **Entire repository capture and session linking:** before enabling capture, review the proposed repository files and local Git hooks. Tally sets Entire's `commit_linking` to `always` in the shared repository settings so its non-interactive worker commits link to their Entire session without prompting during a run. This applies to commits made in that repository. A separate confirmation is required before Tally commits only the listed settings and pushes them to the default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n - **Entire repository mirror:** this is a separate opt-in after capture setup. Confirm only if you want Entire to hold a copy of the GitHub repository. The Entire CLI asks which region or regions to use, and Tally verifies a mirror is ready before it adds browser session links to PRs. Declining keeps local checkpoint capture and normal runs available; hosted recall and hosted session links need a mirror. The selected region and copy are external Entire account changes.\n - **Entire hooks:** after repository capture is published, open your coding agent's hook view, inspect the Entire hooks, and trust them for this repository. If you decline or have not trusted them, init keeps Entire disabled. Tally cannot approve hooks on your behalf.\n - **cfo.ai login and selection:** approving connection starts cfo.ai's OAuth flow in a browser. Select the intended workspace and scenario; these determine which organization's monthly budget and spend tables Tally reads and updates.\n - **cfo.ai table creation:** if required tables are missing, Tally displays their names, rows, formulas, and starting values, then asks before creating them. Existing tables and model data are not reset. Table creation is an external cfo.ai write.\n-- **cfo.ai Ari context:** answering Yes to `Use cfo.ai for budget, spend and Ari context?` adds or updates a Tally-managed guide on the selected scenario page and enables one operational report per attempt in organization-scoped cfo.ai memory. The guide is only updated when it has Tally's marker; other page blocks are left alone. Memory reports are shared with members of the selected workspace. They include task title/ID and issue link, repository, model/tier and configured rates, token usage when reported, estimated cost and its provenance, attempt ceiling/outcome/routing decision, budget snapshot, and PR/Entire/Neatlogs/cfo.ai links. Reports exclude issue bodies, source code and diffs, worker prompts and transcripts, raw trace contents, and credentials. Dry runs do not publish reports. The local ledger remains Tally's record; a failed memory write does not fail verified work and is reported in the run result.\n+- **cfo.ai Ari context:** answering Yes to `Use cfo.ai for budget, spend and Ari context?` adds or updates a Tally-managed guide on the selected scenario page and enables one operational report per attempt in organization-scoped cfo.ai memory. The guide is only updated when it has Tally's marker; other page blocks are left alone. Memory reports are shared with members of the selected workspace. They include task title/ID and issue link, repository, model/tier and configured rates, token usage when reported, estimated cost and its provenance, attempt ceiling/outcome/routing decision, budget snapshot, and PR/Entire/Neatlogs/cfo.ai links. Reports exclude issue bodies, source code and diffs, worker prompts and transcripts, raw trace contents, and credentials. Dry runs do not publish reports. The local ledger remains Tally's record; a refused memory write leaves budget/spend integration connected, reports the sanitized reason, and does not fail verified work.\n - **Neatlogs and cfo.ai software setup:** Neatlogs tracing uses Tally's bundled SDK; cfo.ai uses built-in MCP OAuth. Neither needs a separate product CLI/package. Neatlogs key verification, the global hooks, and cfo.ai context/report setup follow their integration opt-ins as described above.\n \n ## Before each run\n \n - `tally doctor` checks configured connections and agent sign-in. It does not start workers, test a model request, trust Entire hooks, create CFO tables, or publish repository settings.\n+- `gh auth status` verifies the GitHub CLI account. For HTTPS branch/checkpoint pushes, Tally uses `gh auth git-credential` only in the Git push subprocess and disables terminal prompts; it does not change global Git configuration. `tally run` is still the explicit approval to push a branch and open a PR.\n - `neatlogs key: connected` means the ingest key is configured; it does not prove that `NEATLOGS_TOKEN` can read the selected project's history. In a plan, `History source: remote Neatlogs` confirms a matching remote observation. `local Neatlogs fallback` means Tally used local observations; if neither source has usable data, the plan shows `none` and may include a `History note`.\n - `tally run --plan` reads the selected GitHub backlog, local repository signals, Neatlogs history when enabled, and CFO.ai budget/spend when enabled. It starts no coding agent, writes no CFO.ai spend, and creates no PR. Neatlogs history reads have a 15-second total deadline; if that read fails or times out, Tally reports the fallback and uses local history.\n - `tally run --dry-run` uses simulated workers and does not make paid model calls or write simulated spend to CFO.ai. It is not offline: when Neatlogs is enabled, route-decision traces may still be sent remotely. Use `--plan` for a no-worker, read-only preflight; it reads enabled services but does not export decision traces.\ndiff --git a/engine/init.ts b/engine/init.ts\nindex 8a8660c..ec395f3 100644\n--- a/engine/init.ts\n+++ b/engine/init.ts\n@@ -13,6 +13,7 @@ import { aoWorkerMode, withWorkerPermissionMode } from './preflight.js';\n import { aoClaudeSetupCommand } from './ao-claude-settings.js';\n import { aoProjectCommand } from '../adapters/ao-project.js';\n import { configureIntegrations } from '../onboarding/index.js';\n+import type { OnboardingContext } from '../onboarding/types.js';\n import { loadConfig } from './config.js';\n import { readPlanBudget } from './plan.js';\n import { formatUsd } from '../schema/money.js';\n@@ -356,6 +357,7 @@ async function reconfigureInit(options: InitOptions, configPath: string, print:\n   const pending = readReinit(configPath);\n   const before = pending ? parseYaml(pending.beforeConfig) as TallyConfig : loadConfig(configPath);\n   const config = pending ? parseYaml(pending.afterConfig) as TallyConfig : structuredClone(before);\n+  const targetRepo = resolve(dirname(configPath), config.repo.path);\n   if (!validateConfig(before).ok || !validateConfig(config).ok) throw new InitError('Re-init recovery configuration is invalid; no changes made.');\n   if (!pending) {\n     for (const name of ['neatlogs', 'entire', 'cfoai'] as const) {\n@@ -378,6 +380,23 @@ async function reconfigureInit(options: InitOptions, configPath: string, print:\n     }\n     if ((config.runner ?? 'ao') === 'ao') aoWorkerMode(config);\n     await consentClaude(config, options, readLine, print);\n+    // Re-running init is also the repair/upgrade path for repositories that\n+    // already have tally.yaml. Refresh selected integrations before comparing\n+    // the proposed config so new integration settings (for example Entire's\n+    // automatic commit linking or cfo.ai Ari context) are persisted too.\n+    // Dry runs and --yes do not imply consent to external integration changes.\n+    if (!options.dryRun && !options.yes) {\n+      await (options.onboarding ?? configureIntegrations)({ config, repoRoot: targetRepo, ui: {\n+        print,\n+        confirm: async (question) => parseYes(await readLine(`${question} y/N`, 'N')),\n+        select: async (question, choices) => {\n+          choices.forEach((choice, index) => print(`${index + 1}. ${choice}`));\n+          const value = (await readLine(`${question} (number, or Enter to skip)`, '')).trim();\n+          const index = Number(value) - 1;\n+          return /^\\d+$/.test(value) && index >= 0 && index < choices.length ? index : null;\n+        },\n+      } } satisfies OnboardingContext);\n+    }\n   }\n   const validation = validateConfig(config);\n   if (!validation.ok) throw new InitError(`Proposed configuration is invalid: ${validation.errors.join('; ')}; nothing was changed.`);\n@@ -387,7 +406,6 @@ async function reconfigureInit(options: InitOptions, configPath: string, print:\n     return { ...result, applied: false, doctor: [] };\n   }\n   const command: InitCommandRunner = options.command ?? ((file, args, commandOptions) => defaultCommand(file, args, { ...commandOptions, aoBin: config.repo.aoBin ? resolve(dirname(configPath), config.repo.aoBin) : undefined }));\n-  const targetRepo = resolve(dirname(configPath), config.repo.path);\n   await initPrerequisites(config, command, targetRepo, options);\n   const plan = pending ?? prepareReinit(configPath, stringifyYaml(config));\n   print(`Tally re-init proposed diff for ${configPath}:`);\ndiff --git a/engine/real.ts b/engine/real.ts\nindex 0ba23bc..5dc58b0 100644\n--- a/engine/real.ts\n+++ b/engine/real.ts\n@@ -244,13 +244,30 @@ function traceStatus(trace: TracePort | undefined): RunState['integrations']['ne\n }\n \n function neatlogsStatus(ports: RealRunPorts, traceState?: RunState['integrations']['neatlogs']): RunState['integrations']['neatlogs'] {\n-  const workerTraceStatus = ports.workerTraceDrain?.status?.();\n-  const traces = traceState ?? (workerTraceStatus?.status === 'missing' ? workerTraceStatus : traceStatus(ports.trace));\n+  const traces = traceState ?? traceStatus(ports.trace);\n   const history = ports.history.status?.();\n-  if (!history) return traces;\n+  const workerTrace = ports.workerTraceReader?.status?.();\n+  const workerDrain = ports.workerTraceDrain?.status?.();\n+  if (!history) {\n+    const detail = [traces.detail, workerTrace?.detail, workerDrain?.status === 'ok' ? null : workerDrain?.detail]\n+      .filter((value): value is string => Boolean(value));\n+    return { ...traces, detail: detail.length ? [...new Set(detail)].join('; ') : null };\n+  }\n   const priority: Record<IntegrationState['status'], number> = { off: 0, ok: 1, missing: 2, error: 3 };\n-  const status = priority[history.status] > priority[traces.status] ? history.status : traces.status;\n-  const detail = [traces.detail, history.detail].filter((value): value is string => Boolean(value));\n+  const primary = [traces.status, history.status];\n+  const highest = primary.reduce((left, right) => priority[right] > priority[left] ? right : left, 'off' as IntegrationState['status']);\n+  // Missing worker-span read-back is a per-attempt delivery warning. It must\n+  // not make Neatlogs look disconnected when trace ingest or remote history works.\n+  // The card represents whether Neatlogs is reachable for any enabled core\n+  // operation. A broken history read or worker projection is a feature warning\n+  // when the routing trace or another remote feature still works.\n+  const status = primary.includes('ok') ? 'ok' : highest;\n+  const detail = [\n+    traces.detail,\n+    history.detail,\n+    workerTrace?.status === 'ok' ? workerTrace.detail : workerTrace?.detail,\n+    workerDrain?.status === 'ok' ? workerDrain.detail : workerDrain?.detail,\n+  ].filter((value): value is string => Boolean(value));\n   return { status, detail: detail.length > 0 ? [...new Set(detail)].join('; ') : null };\n }\n \n@@ -1060,8 +1077,14 @@ export async function runRealTally(options: RealRunOptions): Promise<RunResult>\n       integrations: integrationStates(config, ports, { dryRun: options.dryRun, budgetSource, cfoaiReadFailure }),\n     };\n     if (cfoaiWriteFailure || cfoaiContextFailures.length) runState.integrations.cfoai = {\n-      status: 'error',\n-      detail: [cfoaiWriteFailure, ...cfoaiContextFailures].filter(Boolean).join(' '),\n+      status: cfoaiWriteFailure ? 'error' : runState.integrations.cfoai.status,\n+      detail: [\n+        runState.integrations.cfoai.detail,\n+        cfoaiWriteFailure,\n+        cfoaiContextFailures.length\n+          ? `Ari context report failed for ${cfoaiContextFailures.length} ${cfoaiContextFailures.length === 1 ? 'attempt' : 'attempts'}: ${cfoaiContextFailures[0]}. Budget and spend tables remain connected; the local ledger is the source of truth.`\n+          : null,\n+      ].filter((value): value is string => Boolean(value)).join(' '),\n     };\n     const workerRows = ledger.filter(row => row.sessionId && (row.harness === 'codex' || row.harness === 'claude-code'));\n     if (!options.dryRun && config.integrations.neatlogs && workerRows.length > 0 && workerRows.every(row => row.workerTraceId)\n@@ -1086,7 +1109,7 @@ export async function runRealTally(options: RealRunOptions): Promise<RunResult>\n         ...(workerDetails.length ? [] : ['Decision traces sent; worker trace delivery is unverified or pending. Run `tally traces drain --run ' + runId + '` to retry.']),\n       ].filter((value): value is string => Boolean(value));\n       runState.integrations.neatlogs = {\n-        status: runState.integrations.neatlogs.status === 'error' ? 'error' : 'missing',\n+        status: runState.integrations.neatlogs.status,\n         detail: [...new Set(details)].join('; '),\n       };\n     }\n@@ -1455,7 +1478,7 @@ export async function runRealTally(options: RealRunOptions): Promise<RunResult>\n         });\n         await ports.cfoai.publishTaskContext(context);\n       } catch (error) {\n-        cfoaiContextFailures.push(`Ari task-context write failed: ${safeCfoaiError(error)}. Local ledger and spend tables remain the source of truth for this attempt.`);\n+        cfoaiContextFailures.push(safeCfoaiError(error));\n       }\n     }\n   }\n","stderr":"","aggregated_output":"diff --git a/adapters/cfoai.ts b/adapters/cfoai.ts\nindex 9ff939b..fcb0a27 100644\n--- a/adapters/cfoai.ts\n+++ b/adapters/cfoai.ts\n@@ -410,15 +410,16 @@ export class CfoaiBudgetAdapter implements BudgetPort {\n     }\n     try {\n       const result = await this.client.callTool('edit_memory', args);\n-      if (isRecord(result) && result.isError === true) throw new Error('cfo.ai refused the Ari context write');\n+      if (isRecord(result) && result.isError === true) throw new Error(cfoaiRefusalMessage(result));\n       const parsed = unwrapToolResult(result);\n       if (isRecord(parsed) && (parsed.status === 'rejected' || parsed.status === 'error')) {\n-        throw new Error('cfo.ai refused the Ari context write');\n+        throw new Error(cfoaiRefusalMessage(parsed));\n       }\n       this.setOkStatus('Ari task context was shared with organization memory.');\n     } catch (error) {\n       const detail = safeCfoaiError(error);\n-      this.statusState = { status: 'error', detail: `Ari task context write failed: ${detail}` };\n+      // Organization memory is optional reporting; its refusal must not label\n+      // working budget reads and spend-table writes as disconnected.\n       throw new Error(detail);\n     }\n   }\n@@ -536,6 +537,22 @@ function successfulEdit(value: unknown): boolean {\n   return isRecord(parsed) && (parsed.status === 'applied' || (parsed.status === 'no_op' && parsed.reason === 'already_satisfied'));\n }\n \n+function cfoaiRefusalMessage(value: unknown): string {\n+  const parsed = unwrapToolResult(value);\n+  let detail: unknown;\n+  if (typeof parsed === 'string') detail = parsed;\n+  else if (isRecord(parsed)) {\n+    const error = parsed.error;\n+    if (isRecord(error)) {\n+      detail = [error.code, error.message, error.hint].filter((part): part is string => typeof part === 'string').join(': ');\n+    } else detail = parsed.message ?? error ?? parsed.reason ?? parsed.detail;\n+  }\n+  const safeDetail = typeof detail === 'string' ? safeCfoaiError(new Error(detail)) : null;\n+  return safeDetail && safeDetail !== 'cfo.ai returned an unspecified error'\n+    ? `cfo.ai refused the Ari context write: ${safeDetail}`\n+    : 'cfo.ai refused the Ari context write';\n+}\n+\n export function safeCfoaiError(error: unknown): string {\n   return (error instanceof Error ? error.message : String(error))\n     .replace(/\\bBearer\\s+[^\\s,;]+/gi, 'Bearer [redacted]')\n@@ -560,7 +577,7 @@ function supportsOrganizationMemory(schema: Record<string, unknown> | undefined)\n         filename: 'tally-schema-check.md',\n         scope: 'organization',\n         tags: ['tally'],\n-        metadata: { source: 'tally-agents' },\n+        metadata: { producer: 'tally-agents' },\n       },\n     });\n   } catch { return false; }\ndiff --git a/docs/HUMAN_APPROVALS.md b/docs/HUMAN_APPROVALS.md\nindex 8784a6e..3572a91 100644\n--- a/docs/HUMAN_APPROVALS.md\n+++ b/docs/HUMAN_APPROVALS.md\n@@ -14,17 +14,18 @@ The integration choices authorize the actions described in their prompt and summ\n - **Neatlogs history read:** if `NEATLOGS_TOKEN` is already present, init connects read-only history automatically after verifying `NEATLOGS_PROJECT_ID` or asking you to select a project. Use a project-scoped token with `context:read` and `observability:read`. Tally stores credentials outside the repository and reads through the Public API; it does not write history records through this reader. Without valid credentials it uses local history. See Neatlogs' [authentication and scopes](https://docs.neatlogs.com/api-reference/authentication) and [pagination contract](https://docs.neatlogs.com/api-reference/pagination).\n - **Entire login and Graph plugin:** approving login starts Entire's own browser authentication; approving Graph installs its CLI plugin. These are account/machine changes and are independent of Tally's final config write.\n - **Entire CLI installation:** if the Entire CLI is missing and Entire is selected, init offers its official platform installer and requires a separate yes. This installs only the CLI. Login, Graph installation, repository capture, hook trust, settings publication, and a repository mirror remain separate approvals. See [Entire's installation guide](https://docs.entire.io/installation).\n-- **Entire repository capture:** before enabling capture, review the proposed repository files and local Git hooks. A second confirmation is required before Tally commits only the listed settings and pushes them to the repository's default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n+- **Entire repository capture and session linking:** before enabling capture, review the proposed repository files and local Git hooks. Tally sets Entire's `commit_linking` to `always` in the shared repository settings so its non-interactive worker commits link to their Entire session without prompting during a run. This applies to commits made in that repository. A separate confirmation is required before Tally commits only the listed settings and pushes them to the default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n - **Entire repository mirror:** this is a separate opt-in after capture setup. Confirm only if you want Entire to hold a copy of the GitHub repository. The Entire CLI asks which region or regions to use, and Tally verifies a mirror is ready before it adds browser session links to PRs. Declining keeps local checkpoint capture and normal runs available; hosted recall and hosted session links need a mirror. The selected region and copy are external Entire account changes.\n - **Entire hooks:** after repository capture is published, open your coding agent's hook view, inspect the Entire hooks, and trust them for this repository. If you decline or have not trusted them, init keeps Entire disabled. Tally cannot approve hooks on your behalf.\n - **cfo.ai login and selection:** approving connection starts cfo.ai's OAuth flow in a browser. Select the intended workspace and scenario; these determine which organization's monthly budget and spend tables Tally reads and updates.\n - **cfo.ai table creation:** if required tables are missing, Tally displays their names, rows, formulas, and starting values, then asks before creating them. Existing tables and model data are not reset. Table creation is an external cfo.ai write.\n-- **cfo.ai Ari context:** answering Yes to `Use cfo.ai for budget, spend and Ari context?` adds or updates a Tally-managed guide on the selected scenario page and enables one operational report per attempt in organization-scoped cfo.ai memory. The guide is only updated when it has Tally's marker; other page blocks are left alone. Memory reports are shared with members of the selected workspace. They include task title/ID and issue link, repository, model/tier and configured rates, token usage when reported, estimated cost and its provenance, attempt ceiling/outcome/routing decision, budget snapshot, and PR/Entire/Neatlogs/cfo.ai links. Reports exclude issue bodies, source code and diffs, worker prompts and transcripts, raw trace contents, and credentials. Dry runs do not publish reports. The local ledger remains Tally's record; a failed memory write does not fail verified work and is reported in the run result.\n+- **cfo.ai Ari context:** answering Yes to `Use cfo.ai for budget, spend and Ari context?` adds or updates a Tally-managed guide on the selected scenario page and enables one operational report per attempt in organization-scoped cfo.ai memory. The guide is only updated when it has Tally's marker; other page blocks are left alone. Memory reports are shared with members of the selected workspace. They include task title/ID and issue link, repository, model/tier and configured rates, token usage when reported, estimated cost and its provenance, attempt ceiling/outcome/routing decision, budget snapshot, and PR/Entire/Neatlogs/cfo.ai links. Reports exclude issue bodies, source code and diffs, worker prompts and transcripts, raw trace contents, and credentials. Dry runs do not publish reports. The local ledger remains Tally's record; a refused memory write leaves budget/spend integration connected, reports the sanitized reason, and does not fail verified work.\n - **Neatlogs and cfo.ai software setup:** Neatlogs tracing uses Tally's bundled SDK; cfo.ai uses built-in MCP OAuth. Neither needs a separate product CLI/package. Neatlogs key verification, the global hooks, and cfo.ai context/report setup follow their integration opt-ins as described above.\n \n ## Before each run\n \n - `tally doctor` checks configured connections and agent sign-in. It does not start workers, test a model request, trust Entire hooks, create CFO tables, or publish repository settings.\n+- `gh auth status` verifies the GitHub CLI account. For HTTPS branch/checkpoint pushes, Tally uses `gh auth git-credential` only in the Git push subprocess and disables terminal prompts; it does not change global Git configuration. `tally run` is still the explicit approval to push a branch and open a PR.\n - `neatlogs key: connected` means the ingest key is configured; it does not prove that `NEATLOGS_TOKEN` can read the selected project's history. In a plan, `History source: remote Neatlogs` confirms a matching remote observation. `local Neatlogs fallback` means Tally used local observations; if neither source has usable data, the plan shows `none` and may include a `History note`.\n - `tally run --plan` reads the selected GitHub backlog, local repository signals, Neatlogs history when enabled, and CFO.ai budget/spend when enabled. It starts no coding agent, writes no CFO.ai spend, and creates no PR. Neatlogs history reads have a 15-second total deadline; if that read fails or times out, Tally reports the fallback and uses local history.\n - `tally run --dry-run` uses simulated workers and does not make paid model calls or write simulated spend to CFO.ai. It is not offline: when Neatlogs is enabled, route-decision traces may still be sent remotely. Use `--plan` for a no-worker, read-only preflight; it reads enabled services but does not export decision traces.\ndiff --git a/engine/init.ts b/engine/init.ts\nindex 8a8660c..ec395f3 100644\n--- a/engine/init.ts\n+++ b/engine/init.ts\n@@ -13,6 +13,7 @@ import { aoWorkerMode, withWorkerPermissionMode } from './preflight.js';\n import { aoClaudeSetupCommand } from './ao-claude-settings.js';\n import { aoProjectCommand } from '../adapters/ao-project.js';\n import { configureIntegrations } from '../onboarding/index.js';\n+import type { OnboardingContext } from '../onboarding/types.js';\n import { loadConfig } from './config.js';\n import { readPlanBudget } from './plan.js';\n import { formatUsd } from '../schema/money.js';\n@@ -356,6 +357,7 @@ async function reconfigureInit(options: InitOptions, configPath: string, print:\n   const pending = readReinit(configPath);\n   const before = pending ? parseYaml(pending.beforeConfig) as TallyConfig : loadConfig(configPath);\n   const config = pending ? parseYaml(pending.afterConfig) as TallyConfig : structuredClone(before);\n+  const targetRepo = resolve(dirname(configPath), config.repo.path);\n   if (!validateConfig(before).ok || !validateConfig(config).ok) throw new InitError('Re-init recovery configuration is invalid; no changes made.');\n   if (!pending) {\n     for (const name of ['neatlogs', 'entire', 'cfoai'] as const) {\n@@ -378,6 +380,23 @@ async function reconfigureInit(options: InitOptions, configPath: string, print:\n     }\n     if ((config.runner ?? 'ao') === 'ao') aoWorkerMode(config);\n     await consentClaude(config, options, readLine, print);\n+    // Re-running init is also the repair/upgrade path for repositories that\n+    // already have tally.yaml. Refresh selected integrations before comparing\n+    // the proposed config so new integration settings (for example Entire's\n+    // automatic commit linking or cfo.ai Ari context) are persisted too.\n+    // Dry runs and --yes do not imply consent to external integration changes.\n+    if (!options.dryRun && !options.yes) {\n+      await (options.onboarding ?? conf