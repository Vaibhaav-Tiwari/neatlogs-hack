== '..')) return null;\n+  return `https://entire.io/gh/${parts.map(encodeURIComponent).join('/')}/session/${encodeURIComponent(sessionId)}`;\n+}\ndiff --git a/adapters/publisher.test.ts b/adapters/publisher.test.ts\nindex 94d67b0..e1a49bb 100644\n--- a/adapters/publisher.test.ts\n+++ b/adapters/publisher.test.ts\n@@ -1,5 +1,5 @@\n import { describe, expect, it } from 'vitest';\n-import { GitHubPublisher, type PublishCommand } from './publisher.js';\n+import { GitHubPublisher, replacePrEvidence, type PublishCommand } from './publisher.js';\n import type { TallyConfig } from '../schema/index.js';\n \n const config: TallyConfig = {\n@@ -115,4 +115,36 @@ describe('GitHubPublisher', () => {\n       'gh pr create --repo acme/payments --head ao/task/root --base main --title T1: Fix math --body Tally run run-1, task T1, attempt 1.\\n\\nBody\\n\\n\\nCloses #7',\n     ]);\n   });\n+\n+  it('adds verified integration links to an existing PR body without replacing its content', async () => {\n+    const calls: string[][] = [];\n+    const publisher = new GitHubPublisher(async (_file, args) => {\n+      calls.push(args);\n+      return { stdout: args[1] === 'view' ? 'Task details\\n\\nCloses #7\\n' : '', stderr: '' };\n+    });\n+    await publisher.updatePrEvidence!({\n+      config,\n+      prUrl: 'https://github.com/acme/payments/pull/42',\n+      links: [\n+        { label: 'Entire session and checkpoint', url: 'https://entire.io/gh/acme/payments/session/session-1', note: 'checkpoint 01M4PROOF' },\n+        { label: 'Neatlogs worker trace', url: 'https://app.neatlogs.com/traces/0123456789abcdef0123456789abcdef' },\n+        { label: 'cfo.ai budget table', url: 'https://app.cfo.ai/s/budget' },\n+      ],\n+    });\n+    expect(calls[0]).toEqual(['pr', 'view', 'https://github.com/acme/payments/pull/42', '--repo', 'acme/payments', '--json', 'body', '-q', '.body']);\n+    expect(calls[1]!.slice(0, 5)).toEqual(['pr', 'edit', 'https://github.com/acme/payments/pull/42', '--repo', 'acme/payments']);\n+    const body = calls[1]![calls[1]!.indexOf('--body') + 1]!;\n+    expect(body).toContain('Task details\\n\\nCloses #7');\n+    expect(body).toContain('[Entire session and checkpoint](https://entire.io/gh/acme/payments/session/session-1) — checkpoint 01M4PROOF');\n+    expect(body).toContain('[Neatlogs worker trace](https://app.neatlogs.com/traces/0123456789abcdef0123456789abcdef)');\n+    expect(body).toContain('[cfo.ai budget table](https://app.cfo.ai/s/budget)');\n+  });\n+\n+  it('replaces a previous evidence block instead of duplicating it', () => {\n+    const first = replacePrEvidence('Task details', [{ label: 'First link', url: 'https://example.com/first' }]);\n+    const second = replacePrEvidence(first, [{ label: 'Updated link', url: 'https://example.com/updated' }]);\n+    expect(second.match(/tally-run-evidence:start/g)).toHaveLength(1);\n+    expect(second).toContain('[Updated link](https://example.com/updated)');\n+    expect(second).not.toContain('[First link]');\n+  });\n });\ndiff --git a/adapters/publisher.ts b/adapters/publisher.ts\nindex ba813b0..35fa438 100644\n--- a/adapters/publisher.ts\n+++ b/adapters/publisher.ts\n@@ -1,5 +1,6 @@\n import { runCommand } from './command.js';\n import type { BacklogTask } from '../engine/backlog.js';\n+import type { PrEvidenceLink } from '../engine/pr-evidence.js';\n import type { TallyConfig } from '../schema/index.js';\n \n const execFileAsync = runCommand;\n@@ -20,10 +21,35 @@ export interface PublishPrInput extends WorkerBranchInput {\n   scopeWarnings?: string[];\n }\n \n+export interface UpdatePrEvidenceInput {\n+  config: TallyConfig;\n+  prUrl: string;\n+  links: PrEvidenceLink[];\n+}\n+\n export interface PublishPort {\n   commitsAhead(input: WorkerBranchInput): Promise<number>;\n   changedFiles(input: WorkerBranchInput): Promise<string[]>;\n   publishPr(input: PublishPrInput): Promise<string>;\n+  updatePrEvidence?(input: UpdatePrEvidenceInput): Promise<void>;\n+}\n+\n+const EVIDENCE_START = '<!-- tally-run-evidence:start -->';\n+const EVIDENCE_END = '<!-- tally-run-evidence:end -->';\n+\n+function evidenceMarkdown(links: PrEvidenceLink[]): string {\n+  if (!links.length) return '';\n+  const lines = [EVIDENCE_START, '### Tally run evidence', ...links.map(({ label, url, note }) =>\n+    `- [${label}](${url.replaceAll('(', '%28').replaceAll(')', '%29')})${note ? ` — ${note.replace(/[\\r\\n]/g, ' ')}` : ''}`), EVIDENCE_END];\n+  return lines.join('\\n');\n+}\n+\n+export function replacePrEvidence(body: string, links: PrEvidenceLink[]): string {\n+  const evidence = evidenceMarkdown(links);\n+  const existing = new RegExp(`${EVIDENCE_START}[\\\\s\\\\S]*?${EVIDENCE_END}`, 'm');\n+  if (!evidence) return body.replace(existing, '').trimEnd();\n+  if (existing.test(body)) return body.replace(existing, () => evidence);\n+  return `${body.trimEnd()}${body.trim() ? '\\n\\n' : ''}${evidence}`;\n }\n \n function defaultCommand(file: string, args: string[], options?: { cwd?: string }) {\n@@ -94,6 +120,14 @@ export class GitHubPublisher implements PublishPort {\n     }\n   }\n \n+  async updatePrEvidence(input: UpdatePrEvidenceInput): Promise<void> {\n+    if (!input.config.repo.slug) throw new Error('repo.slug is required to update a GitHub pull request');\n+    if (!input.links.length) return;\n+    const { stdout } = await this.command('gh', ['pr', 'view', input.prUrl, '--repo', input.config.repo.slug, '--json', 'body', '-q', '.body']);\n+    const body = replacePrEvidence(stdout.replace(/\\r?\\n$/, ''), input.links);\n+    await this.command('gh', ['pr', 'edit', input.prUrl, '--repo', input.config.repo.slug, '--body', body]);\n+  }\n+\n   private async pushCheckpoints(input: PublishPrInput): Promise<void> {\n     const options = { cwd: input.checkoutPath };\n     const { stdout: messages } = await this.command('git', [\ndiff --git a/docs/GETTING_STARTED.md b/docs/GETTING_STARTED.md\nindex 35c2c2a..bcdf183 100644\n--- a/docs/GETTING_STARTED.md\n+++ b/docs/GETTING_STARTED.md\n@@ -151,9 +151,9 @@ Plans share one bounded Neatlogs history snapshot across tier lookups. The full\n \n Worker tracing additionally needs harness hooks and usable read access for Tally to verify delivery. The optional **GLOBAL worker-hook installation** changes `~/.claude/settings.json` and `~/.codex/hooks.json` and traces sessions outside Tally too; approve only if you want that machine-wide behavior. Codex also needs you to trust hooks via `/hooks`. You can decline global installation and use existing hooks. Do not mistake a configured API key or decision trace for proof that worker traces arrived.\n \n-**Entire:** init can offer login, Graph plugin installation, repository capture settings, and missing harness hooks, each with consent. It lists generated files before asking to enable capture, then separately asks before committing those settings and pushing them to the repository's default branch. This is an optional setup action, not task publishing: decline and use your usual review process if you do not want it. Future workers need the capture settings on their base branch; uncommitted settings are not enough. Codex hook trust is a separate `/hooks` confirmation.\n+**Entire:** init can offer login, Graph plugin installation, repository capture settings, missing harness hooks, and an optional browser mirror, each with consent. It lists generated files before asking to enable capture, then separately asks before committing those settings and pushing them to the repository's default branch. The mirror prompt is separate: approving it sends the GitHub repository copy to the Entire region or regions you choose in the Entire CLI. Decline to keep the existing setup without a mirror. Capture settings must reach the base branch for future workers; uncommitted settings are not enough. Codex hook trust is a separate `/hooks` confirmation.\n \n-Entire being off does not prevent Tally sizing tasks from issue text and repository evidence. Being on adds Graph and local checkpoints. **Hosted past-failure checkpoint recall needs an accessible repository mirrored to Entire.** If hosted recall is unavailable, normal planning and local capture remain available. Brain is a separate memory extension; Tally does not install or use it. Generated summaries are off by default and require separate approval.\n+Entire being off does not prevent Tally sizing tasks from issue text and repository evidence. Being on adds Graph and local checkpoints. **Hosted past-failure checkpoint recall and clickable Entire session links need an accessible repository mirrored to Entire.** Init can offer this as a separate opt-in and verifies that the mirror is ready. If you skip it, local capture and normal runs remain available, but the PR shows a checkpoint ID instead of a hosted session link. Brain is a separate memory extension; Tally does not install or use it. Generated summaries are off by default and require separate approval.\n \n ### Reading Entire's Doctor Status\n \n@@ -164,6 +164,8 @@ Run `tally doctor` again after init. When Entire is on, it reports separate chec\n | `Entire CLI: connected` | The CLI is available. |\n | `Entire graph plugin: connected` | The Graph command is installed; this is not proof that hosted recall works. |\n | `Entire repository: connected` | Session capture is enabled in this repository. |\n+| `Entire Web mirror: connected` | This GitHub repository has a ready Entire Web mirror. This is separate from local capture and Git-remote checkpoint sync. |\n+| `Entire Web mirror: unavailable` | The mirror is optional or could not be checked. Tally keeps local capture and normal task runs available; the line includes an opt-in setup hint. |\n | `Entire checkpoint recall: connected` | Hosted checkpoint search answered successfully, even if it returned no matching checkpoints. |\n | `Entire checkpoint recall: unavailable` | Hosted recall could not access this repository. This is optional. The line gives a mirror/account-access hint, while local capture and normal task runs remain available. |\n | `Entire checkpoint recall: broken` | Hosted search failed for another reason. The line includes the actual error and a relevant check. |\n@@ -298,7 +300,7 @@ Ceilings are **polling-based safety thresholds, not billing guarantees**: usage\n | Latest run | `.tally/runs/latest/run.json` and `ledger.json`; the dashboard's stable data path. |\n | Dashboard | Printed local URL, run picker, task decisions, attempt results and evidence links. It serves recorded files read-only on `127.0.0.1`. |\n | neatlogs | Decision `traceId`/link and `workerTraceId`/link on the ledger row. Worker delivery requires capture hooks plus correlated read-back. `workerTraceDetail` and run integration status now retain actionable lock, auth, project, network, and indexing diagnostics. Null means not established, not an invisible success. |\n-| Entire | `checkpointId`, `entireSessionId`, any returned checkpoint URL, and handoff metadata. Off integrations or attempts without a captured checkpoint can legitimately have null IDs. A local checkpoint does not prove a hosted link exists. |\n+| Entire | `checkpointId`, `entireSessionId`, a session URL when the repo has a ready Entire mirror, and handoff metadata. Off integrations or attempts without a captured checkpoint can legitimately have null IDs. The PR body and dashboard link to Entire only when the mirror is ready. |\n | cfo.ai | Configured monthly `Agent budget`, `Agent spend`, `Budget remaining`, and tier rows in the spend-detail table. Dashboard/run state…2350 tokens truncated…+    config.integrations = { neatlogs: true, entire: true, cfoai: true, slack: false };\n+    config.budget.cfoai = {\n+      tableUrl: 'https://app.cfo.ai/s/budget',\n+      spendDetailTableUrl: 'https://app.cfo.ai/s/spend',\n+    };\n+    expect(prEvidenceLinks(row, config)).toEqual([\n+      { label: 'Entire session and checkpoint', url: 'https://entire.io/gh/acme/payments/session/session-1', note: 'checkpoint 01M4PROOF' },\n+      { label: 'Neatlogs routing trace', url: 'https://app.neatlogs.com/traces/0123456789abcdef0123456789abcdef' },\n+      { label: 'Neatlogs worker trace', url: 'https://app.neatlogs.com/traces/fedcba9876543210fedcba9876543210' },\n+      { label: 'cfo.ai budget table', url: 'https://app.cfo.ai/s/budget' },\n+      { label: 'cfo.ai spend table', url: 'https://app.cfo.ai/s/spend' },\n+    ]);\n+  });\n+\n+  it('does not create links when integration data is disabled, malformed, or absent', () => {\n+    const config = sampleConfig();\n+    config.repo.slug = 'bad-slug';\n+    config.integrations.entire = true;\n+    expect(prEvidenceLinks({ ...row, checkpointUrl: null, entireSessionId: null }, config)).toEqual([]);\n+    expect(neatlogsTraceUrl('not-a-trace')).toBeNull();\n+  });\n+});\ndiff --git a/engine/pr-evidence.ts b/engine/pr-evidence.ts\nnew file mode 100644\nindex 0000000..a0519ba\n--- /dev/null\n+++ b/engine/pr-evidence.ts\n@@ -0,0 +1,43 @@\n+import type { LedgerRow, TallyConfig } from '../schema/index.js';\n+import { neatlogsTraceUrl } from '../adapters/evidence-links.js';\n+\n+export interface PrEvidenceLink {\n+  label: string;\n+  url: string;\n+  note?: string;\n+}\n+\n+function httpsUrl(value: string | null | undefined): string | null {\n+  if (!value) return null;\n+  try {\n+    const url = new URL(value);\n+    return url.protocol === 'https:' ? url.toString() : null;\n+  } catch {\n+    return null;\n+  }\n+}\n+\n+export function prEvidenceLinks(row: LedgerRow, config: TallyConfig): PrEvidenceLink[] {\n+  const links: PrEvidenceLink[] = [];\n+  if (config.integrations.entire) {\n+    const checkpointUrl = httpsUrl(row.checkpointUrl);\n+    if (checkpointUrl) links.push({\n+      label: 'Entire session and checkpoint',\n+      url: checkpointUrl,\n+      ...(row.checkpointId ? { note: `checkpoint ${row.checkpointId}` } : {}),\n+    });\n+  }\n+  if (config.integrations.neatlogs) {\n+    const decisionTraceUrl = httpsUrl(row.traceUrl) ?? neatlogsTraceUrl(row.traceId);\n+    const workerTraceUrl = httpsUrl(row.workerTraceUrl) ?? neatlogsTraceUrl(row.workerTraceId);\n+    if (decisionTraceUrl) links.push({ label: 'Neatlogs routing trace', url: decisionTraceUrl });\n+    if (workerTraceUrl) links.push({ label: 'Neatlogs worker trace', url: workerTraceUrl });\n+  }\n+  if (config.integrations.cfoai || config.budget.source === 'cfoai') {\n+    const budgetUrl = httpsUrl(config.budget.cfoai?.tableUrl);\n+    const spendUrl = httpsUrl(config.budget.cfoai?.spendDetailTableUrl);\n+    if (budgetUrl) links.push({ label: 'cfo.ai budget table', url: budgetUrl });\n+    if (spendUrl) links.push({ label: 'cfo.ai spend table', url: spendUrl });\n+  }\n+  return links;\n+}\ndiff --git a/engine/real.test.ts b/engine/real.test.ts\nindex 169bc09..5f38295 100644\n--- a/engine/real.test.ts\n+++ b/engine/real.test.ts\n@@ -1318,6 +1318,58 @@ describe('runRealTally', () => {\n     expect(validateLedger(result.ledger).ok).toBe(true);\n   });\n \n+  it('adds Entire, Neatlogs, and cfo.ai links to the PR after evidence read-back', async () => {\n+    const { dir, configPath } = fixture('neatlogs: true, entire: true, cfoai: true, slack: false');\n+    const config = loadConfig(configPath);\n+    config.tiers = config.tiers.map(tier => ({ ...tier, harness: 'codex', provider: 'openai', model: 'gpt-5.6-luna' }));\n+    config.budget.cfoai = {\n+      tableUrl: 'https://app.cfo.ai/s/budget',\n+      spendDetailTableUrl: 'https://app.cfo.ai/s/spend',\n+    };\n+    writeFileSync(configPath, stringifyYaml(config));\n+    const worker = new FakeWorker();\n+    const evidenceUpdates: Array<{ prUrl: string; links: Array<{ label: string; url: string; note?: string }> }> = [];\n+    const publisher = {\n+      commitsAhead: worker.commitsAhead.bind(worker),\n+      changedFiles: worker.changedFiles.bind(worker),\n+      publishPr: worker.publishPr.bind(worker),\n+      updatePrEvidence: async (input: typeof evidenceUpdates[number]) => { evidenceUpdates.push(input); },\n+    };\n+    const result = await runRealTally({\n+      configPath,\n+      dryRun: false,\n+      baseline: false,\n+      outputDir: join(dir, 'evidence-links'),\n+      latestRunDir: join(dir, 'latest'),\n+      now: fixedNow,\n+      ports: {\n+        intake,\n+        signals: scriptedEntireSignals,\n+        worker,\n+        usage: worker,\n+        sessions: worker,\n+        publisher,\n+        verifier: new SequenceVerifier([{ passed: true, reason: null }]),\n+        trace: new FakeTrace(),\n+        history: { lookup: async () => null, record: async () => {}, status: () => ({ status: 'ok' as const, detail: null }) },\n+        checkpoints: { checkpointFor: async () => ({ checkpointId: '01M4PROOF', checkpointUrl: 'https://entire.io/gh/acme/payments-service/session/native-session-1', entireSessionId: 'native-session-1' }) },\n+        workerTraceDrain: { drainWorker: async () => {} },\n+        workerTraceReader: { verifyFor: async () => 'b'.repeat(32) },\n+      },\n+    });\n+    expect(evidenceUpdates).toHaveLength(1);\n+    expect(evidenceUpdates[0]?.prUrl).toBe('https://github.com/acme/payments-service/pull/1');\n+    expect(evidenceUpdates[0]?.links).toEqual(expect.arrayContaining([\n+      expect.objectContaining({ label: 'Entire session and checkpoint', url: 'https://entire.io/gh/acme/payments-service/session/native-session-1', note: 'checkpoint 01M4PROOF' }),\n+      expect.objectContaining({ label: 'Neatlogs routing trace', url: expect.stringMatching(/^https:\\/\\/app\\.neatlogs\\.com\\/traces\\//) }),\n+      expect.objectContaining({ label: 'Neatlogs worker trace', url: 'https://app.neatlogs.com/traces/' + 'b'.repeat(32) }),\n+      expect.objectContaining({ label: 'cfo.ai budget table', url: 'https://app.cfo.ai/s/budget' }),\n+      expect.objectContaining({ label: 'cfo.ai spend table', url: 'https://app.cfo.ai/s/spend' }),\n+    ]));\n+    expect(result.ledger[0]?.checkpointUrl).toBe('https://entire.io/gh/acme/payments-service/session/native-session-1');\n+    expect(result.ledger[0]?.workerTraceUrl).toBe('https://app.neatlogs.com/traces/' + 'b'.repeat(32));\n+  });\n+\n   it('lowers routing confidence when Entire recalls a prior failure on the same files', async () => {\n     const { dir, configPath } = fixture('neatlogs: false, entire: true, cfoai: false, slack: false');\n     const worker = new FakeWorker();\ndiff --git a/engine/real.ts b/engine/real.ts\nindex 2afeda2..6f456a0 100644\n--- a/engine/real.ts\n+++ b/engine/real.ts\n@@ -34,6 +34,8 @@ import { type BacklogIntakePort, ConfigBacklogIntake } from '../adapters/github.\n import { historyAttributes, historyTraceName } from '../adapters/neatlogs-history.js';\n import { NeatlogsTraceAdapter } from '../adapters/neatlogs.js';\n import { GitHubPublisher, type PublishPort } from '../adapters/publisher.js';\n+import { neatlogsTraceUrl } from '../adapters/evidence-links.js';\n+import { prEvidenceLinks } from './pr-evidence.js';\n import { outOfScopeFiles } from './scope.js';\n import { CommandVerifier, EntireGraphVerifier, type VerifierPort } from '../adapters/verifier.js';\n import { attemptId, ceilingNanos, SCHEMA_VERSION, usdToNanos, validateLedger, validateRunState } from '../schema/index.js';\n@@ -187,7 +189,7 @@ function resolvePorts(config: TallyConfig, configPath: string, overrides: Partia\n       : undefined;\n   const entireCheckpoints =\n     config.integrations.entire && (!hasPort(overrides, 'handoff') || !hasPort(overrides, 'checkpoints'))\n-      ? new EntireCheckpointAdapter({ repoPath, generatedSummaries: config.entire?.generatedSummaries })\n+      ? new EntireCheckpointAdapter({ repoPath, repoSlug: config.repo.slug, generatedSummaries: config.entire?.generatedSummaries })\n       : undefined;\n   const handoff = overrides.handoff ?? entireCheckpoints;\n   const checkpoints = overrides.checkpoints ?? entireCheckpoints;\n@@ -731,8 +733,8 @@ async function runSingleAttempt(input: {\n     try {\n       const checkpoint = await input.ports.checkpoints.checkpointFor({ sessionId: started.sessionId, branch, checkoutPath });\n       checkpointId = checkpoint?.checkpointId ?? null;\n-      checkpointUrl = checkpoint?.checkpointUrl ?? null;\n       entireSessionId = checkpoint?.entireSessionId ?? null;\n+      checkpointUrl = checkpoint?.checkpointUrl ?? null;\n     } catch {\n       checkpointId = null;\n       checkpointUrl = null;\n@@ -838,9 +840,9 @@ async function runSingleAttempt(input: {\n     handoffText: input.handoffSummary,\n     prUrl: input.dryRun ? null : prUrl,\n     traceId: input.traceId,\n-    traceUrl: null,\n+    traceUrl: input.config.integrations.neatlogs ? neatlogsTraceUrl(input.traceId) : null,\n     workerTraceId,\n-    workerTraceUrl: null,\n+    workerTraceUrl: input.config.integrations.neatlogs ? neatlogsTraceUrl(workerTraceId) : null,\n     ...(workerTraceDetail ? { workerTraceDetail } : {}),\n     checkpointId,\n     checkpointUrl,\n@@ -1403,9 +1405,34 @@ export async function runRealTally(options: RealRunOptions): Promise<RunResult>\n     }\n   }\n \n+  await (ports.trace as (TracePort & { flush?: () => Promise<void> }) | undefined)?.flush?.();\n+  for (const row of ledger) {\n+    if (config.integrations.neatlogs) {\n+      row.traceUrl ??= neatlogsTraceUrl(row.traceId);\n+      row.workerTraceUrl ??= neatlogsTraceUrl(row.workerTraceId);\n+    }\n+  }\n+\n+  let evidenceUpdateFailure: string | null = null;\n+  if (!options.dryRun && ports.publisher.updatePrEvidence) {\n+    const publishedRows = new Map(ledger.filter(row => row.prUrl).map(row => [row.prUrl!, row]));\n+    for (const [prUrl, row] of publishedRows) {\n+      const links = prEvidenceLinks(row, config);\n+      if (!links.length) continue;\n+      try {\n+        await ports.publisher.updatePrEvidence({ config, prUrl, links });\n+      } catch (error) {\n+        const detail = error instanceof Error ? error.message : String(error);\n+        evidenceUpdateFailure ??= `PR evidence links could not be attached to ${prUrl}: ${detail}`;\n+      }\n+    }\n+  }\n+\n   const endedAt = now().toISOString();\n   const runState = writeCurrent(stopRequested() ? 'interrupted' : 'finished', endedAt);\n-  await (ports.trace as (TracePort & { flush?: () => Promise<void> }) | undefined)?.flush?.();\n+  if (evidenceUpdateFailure) {\n+    runState.integrations.github = { status: 'error', detail: evidenceUpdateFailure };\n+  }\n   const paths = writeRunFiles(outputDir, runState, ledger, options.latestRunDir);\n   return { runState, ledger, ...paths };\n }\ndiff --git a/onboarding/entire.test.ts b/onboarding/entire.test.ts\nindex d4c2145..d04f175 100644\n--- a/onboarding/entire.test.ts\n+++ b/onboarding/entire.test.ts\n@@ -6,7 +6,8 @@ import type { OnboardingContext } from './types.js';\n function fixture(answers: boolean[] = [true]) {\n   const cwd = '/tmp/tally-onboarding-target';\n   const state = { loggedIn: true, graph: true, enabled: true, agents: ['Codex'], dirty: '', generated: '', branch: 'main',\n-    local: 'base-sha', remote: 'base-sha', published: true, remoteHooks: true, fail: '', loginWorks: true, pluginWorks: true };\n+    local: 'base-sha', remote: 'base-sha', published: true, remoteHooks: true, fail: '', loginWorks: true, pluginWorks: true,\n+    mirrors: [] as Array<{ repo: string; status: string; placements: Array<{ cluster: string; status: string }> }>, mirrorAdded: false };\n   const calls: { file: string; args: string[]; cwd: string; interactive?: boolean }[] = [];\n   const command: EntireOnboardingCommand = async (file, args, options) => {\n     calls.push({ file, args, ...options });\n@@ -22,6 +23,9 @@ function fixture(answers: boolean[] = [true]) {\n       else if (args[0] === 'status') stdout = JSON.stringify({ enabled: state.enabled, agents: state.agents });\n       else if (args[0] === 'enable') { state.enabled = true; state.agents = [args[args.indexOf('--agent') + 1]! === 'codex' ? 'Codex' : 'Claude Code']; state.generated = '?? .entire/settings.json\\n?? .codex/hooks.json'; }\n       else if (args[0] === 'agent') { state.agents.push(args[2] === 'codex' ? 'Codex' : 'Claude Code'); state.generated = ' M .codex/hooks.json'; }\n+      else if (args[0] === 'repo' && args[1] === 'mirror' && args[2] === 'list') stdout = JSON.stringify(state.mirrors);\n+      else if (args[0] === 'repo' && args[1] === 'mirror' && args[2] === 'add') state.mirrorAdded = true;\n+      else if (args[0] === 'repo' && args[1] === 'view') stdout = JSON.stringify({ placements: state.mirrorAdded ? [{ cluster: 'aws-ap-south-1.entire.io', status: 'ready' }] : [] });\n       else throw new Error(`Unexpected ${name}`);\n     } else if (file === 'git') {\n       if (args[0] === 'rev-parse') stdout = args[1] === '--show-toplevel' ? cwd : args[1] === 'HEAD' ? state.local : state.remote;\n@@ -61,6 +65,32 @@ describe('Entire onboarding', () => {\n     expect(vi.mocked(f.context.ui.confirm).mock.calls.join('\\n')).not.toContain(';');\n     expect(f.calls.every(call => call.cwd === f.context.repoRoot)).toBe(true);\n   });\n+  it('reports an existing mirror without asking or changing it', async () => {\n+    const f = fixture([true]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    f.state.mirrors = [{ repo: '/gh/acme/widgets', status: 'ready', placements: [{ cluster: 'aws-ap-south-1.entire.io', status: 'ready' }] }];\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    expect(f.calls.some(c => c.args.join(' ') === 'repo mirror add /gh/acme/widgets --timeout 5m')).toBe(false);\n+    expect(vi.mocked(f.context.ui.confirm).mock.calls).toHaveLength(1);\n+    expect(vi.mocked(f.context.ui.print).mock.calls.join(' ')).toContain('Entire mirror ready on aws-ap-south-1.entire.io.');\n+  });\n+  it('asks before creating an Entire mirror and lets the Entire CLI collect region choice', async () => {\n+    const f = fixture([true, true]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    const add = f.calls.find(c => c.args.join(' ') === 'repo mirror add /gh/acme/widgets --timeout 5m');\n+    expect(add?.interactive).toBe(true);\n+    expect(f.calls.some(c => c.args.join(' ') === 'repo view /gh/acme/widgets --json')).toBe(true);\n+    expect(vi.mocked(f.context.ui.confirm).mock.calls[1]![0]).toBe('Mirror this repository in Entire?');\n+    expect(vi.mocked(f.context.ui.print).mock.calls.join(' ')).toContain('Entire mirror ready for acme/widgets.');\n+  });\n+  it('keeps Entire enabled when the user skips the optional mirror', async () => {\n+    const f = fixture([true, false]);\n+    f.context.config.repo.slug = 'acme/widgets';\n+    expect((await f.module.configure(f.context)).enabled).toBe(true);\n+    expect(f.state.mirrorAdded).toBe(false);\n+    expect(f.calls.some(c => c.args[0] === 'repo' && c.args[1] === 'mirror' && c.args[2] === 'add')).toBe(false);\n+  });\n   it('keeps Entire off when hook trust is skipped', async () => {\n     const f = fixture([false]);\n     expect((await f.module.configure(f.context)).enabled).toBe(false);\ndiff --git a/onboarding/entire.ts b/onboarding/entire.ts\nindex 73fd23b..9b7208d 100644\n--- a/onboarding/entire.ts\n+++ b/onboarding/entire.ts\n@@ -32,6 +32,26 @@ export interface EntireOnboardingOptions {\n   command?: EntireOnboardingCommand;\n }\n \n+interface EntireMirrorPlacement {\n+  cluster?: unknown;\n+  status?: unknown;\n+}\n+\n+interface EntireMirrorRecord {\n+  repo?: unknown;\n+  status?: unknown;\n+  placements?: EntireMirrorPlacement[];\n+}\n+\n+function mirrorRecords(output: string): EntireMirrorRecord[] {\n+  const parsed: unknown = JSON.parse(output);\n+  if (Array.isArray(parsed)) return parsed as EntireMirrorRecord[];\n+  if (parsed && typeof parsed === 'object' && Array.isArray((parsed as { items?: unknown }).items)) {\n+    return (parsed as { items: EntireMirrorRecord[] }).items;\n+  }\n+  throw new Error('Unreadable Entire mirror status');\n+}\n+\n export class EntireOnboarding implements IntegrationOnboarding {\n   private cwd: string;\n   private readonly command: EntireOnboardingCommand;\n@@ -51,6 +71,48 @@ export class EntireOnboarding implements IntegrationOnboarding {\n   private async status(): Promise<Record<string, unknown>> {\n     return json(await this.run('entire', ['status', '--json']));\n   }\n+  private async ensureMirror(context: OnboardingContext): Promise<string | null> {\n+    const slug = context.config.repo.slug;\n+    if (!slug) return null;\n+    const repoRef = `/gh/${slug}`;\n+    let records: EntireMirrorRecord[];\n+    try {\n+      records = mirrorRecords(await this.run('entire', ['repo', 'mirror', 'list', '--json', '--mirrored', '--name', slug]));\n+    } catch {\n+      const detail = `Could not check Entire mirror status. If you want a browser mirror, run \\`entire repo mirror add ${repoRef}\\` after onboarding.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+    const existing = records.find(record => record.repo === repoRef);\n+    const placements = existing?.placements ?? [];\n+    if (placements.some(placement => placement.status === 'ready')) {\n+      const clusters = placements.filter(placement => placement.status === 'ready')\n+        .map(placement => typeof placement.cluster === 'string' ? placement.cluster : null).filter(Boolean);\n+      const detail = `Entire mirror ready${clusters.length ? ` on ${clusters.join(', ')}` : ''}.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+    context.ui.print('Optional Entire browser mirror');\n+    context.ui.print(`  This creates a copy of ${slug} in Entire so checkpoint sessions can open in its web app.`);\n+    context.ui.print('  The Entire CLI will ask which region or regions should store the copy. You can skip this.');\n+    if (!await context.ui.confirm('Mirror this repository in Entire?')) {\n+      context.ui.print('Entire mirror skipped. Graph sizing and local checkpoint capture remain enabled.');\n+      return 'Entire mirror skipped.';\n+    }\n+    try {\n+      await this.run('entire', ['repo', 'mirror', 'add', repoRef, '--timeout', '5m'], true);\n+      const view = json(await this.run('entire', ['repo', 'view', repoRef, '--json']));\n+      const ready = Array.isArray(view.placements) && view.placements.some(placement =>\n+        !!placement && typeof placement === 'object' && (placement as EntireMirrorPlacement).status === 'ready');\n+      if (!ready) throw new Error('Entire mirror is not ready yet');\n+      context.ui.print(`Entire mirror ready for ${slug}.`);\n+      return 'Entire mirror ready.';\n+    } catch {\n+      const detail = `Entire capture remains enabled, but the mirror could not be verified. Retry with \\`entire repo mirror add ${repoRef}\\`.`;\n+      context.ui.print(detail);\n+      return detail;\n+    }\n+  }\n   async check(): Promise<IntegrationState> {\n     try {\n       await this.run('entire', ['--version']);\n@@ -151,7 +213,8 @@ export class EntireOnboarding implements IntegrationOnboarding {\n       if (required.includes('codex') && !await context.ui.confirm('Have you trusted the Entire hooks via /hooks in Codex for this repository?')) {\n         return off('Codex hook trust is not confirmed. Entire remains off until you trust the hooks.');\n       }\n-      return { enabled: true, state: { status: 'ok', detail: 'Entire login, graph and repository capture are configured. Generated summaries remain off by default.' } };\n+      const mirror = await this.ensureMirror(context);\n+      return { enabled: true, state: { status: 'ok', detail: ['Entire login, graph and repository capture are configured.', mirror, 'Generated summaries remain off by default.'].filter(Boolean).join(' ') } };\n     } catch { return off('Entire setup could not be verified. Any generated files remain for review. No further changes were attempted.'); }\n   }\n }\n"},"started_at_ms":1791807492611,"completed_at_ms":1791807495472}}
{"timestamp":"2026-10-12T12:18:15.675Z","ordinal":16400,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a125af-5d46-7871-9bed-a128df2c2957","turn_id":"01a1300c-41d0-7252-878d-fac3cabd2b16","item":{"type":"CommandExecution","id":"exec-93663deb-7348-4586-a152-cb27ac358340","process_id":"31065","command":["/bin/zsh","-lc","git show 4fedb7a:docs/HUMAN_APPROVALS.md"],"cwd":"file:///Users/vaibhaav/.ao/data/worktrees/neatlogs-hack/neatlogs-hack-5","parsed_cmd":[{"type":"unknown","cmd":"git show 4fedb7a:docs/HUMAN_APPROVALS.md"}],"source":"unified_exec_startup","status":"completed","stdout":"# Human approval points\n\nTally keeps account access, data capture, repository changes, and paid work behind separate choices. A successful `tally doctor` check proves a connection is reachable; it does not approve hooks, capture, table creation, or a worker run.\n\n## Setup choices\n\n### `tally init`\n\nReview the final proposal before answering `Apply these changes?`. It shows the repository and base branch, tests and setup commands, models, budget, runner, integrations, and files/configuration to be written. This last confirmation writes `tally.yaml` and `.tally/install.json`; AO setup, when selected, also changes the named AO project settings. Setup and test commands execute repository code and can install dependencies.\n\nThe integration table is a selection summary, not proof that each integration is fully ready. The following steps have their own consent:\n\n- **Neatlogs project key:** `NEATLOGS_API_KEY` authorizes decision-trace export. A consented SDK probe sends synthetic probe spans. Tally stores credentials outside the repository. This key does not grant Public API history reads.\n- **Neatlogs history read:** selecting a project and saving a service-account token enables read-only history lookups. Use a project-scoped token with `context:read` for project discovery and `observability:read` for traces and spans. Tally uses the Public API's bearer token, `x-project-id`, and cursor pagination; it does not write history records remotely through this reader. See Neatlogs' [authentication and scopes](https://docs.neatlogs.com/api-reference/authentication) and [pagination contract](https://docs.neatlogs.com/api-reference/pagination).\n- **Global Neatlogs hooks:** the separate global-hook prompt installs packages globally and changes `~/.claude/settings.json` and `~/.codex/hooks.json`. These hooks can observe coding-agent sessions outside Tally, so approve only if machine-wide tracing is intended and allowed for the data on this machine. In Codex, open `/hooks`, inspect the exact Neatlogs hook definitions, and trust them yourself. Tally cannot grant that trust.\n- **Entire login and Graph plugin:** approving login starts Entire's own browser authentication; approving Graph installs its CLI plugin. These are account/machine changes and are independent of Tally's final config write.\n- **Entire repository capture:** before enabling capture, review the proposed repository files and local Git hooks. A second confirmation is required before Tally commits only the listed settings and pushes them to the repository's default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n- **Entire repository mirror:** this is a separate opt-in after capture setup. Confirm only if you want Entire to hold a copy of the GitHub repository. The Entire CLI asks which region or regions to use, and Tally verifies a mirror is ready before it adds browser session links to PRs. Declining keeps local checkpoint capture and normal runs available; hosted recall and hosted session links need a mirror. The selected region and copy are external Entire account changes.\n- **Entire Codex hooks:** after repository capture is published, open Codex in that repository, run `/hooks`, inspect the Entire hooks, and trust them yourself. If you decline or have not trusted them, init keeps Entire disabled. Tally cannot approve hooks on your behalf. See the [Codex Hooks documentation](https://learn.chatgpt.com/docs/hooks).\n- **cfo.ai login and selection:** approving connection starts cfo.ai's OAuth flow in a browser. Select the intended workspace and scenario; these determine which organization's monthly budget and spend tables Tally reads and updates.\n- **cfo.ai table creation:** if required tables are missing, Tally displays their names, rows, formulas, and starting values, then asks before creating them. Existing tables and model data are not reset. Table creation is an external cfo.ai write.\n\n## Before each run\n\n- `tally doctor` checks configured connections. It does not start workers, trust hooks, create tables, or publish repository settings.\n- `neatlogs key: connected` means the ingest key is configured; it does not prove that `NEATLOGS_TOKEN` can read the selected project's history. In a plan, `History source: remote Neatlogs` confirms a matching remote observation. `local Neatlogs fallback` means Tally used local observations; if neither source has usable data, the plan shows `none` and may include a `History note`.\n- `tally run --plan` reads the selected GitHub backlog, local repository signals, Neatlogs history when enabled, and CFO.ai budget/spend when enabled. It starts no coding agent, writes no CFO.ai spend, and creates no PR. Neatlogs history reads have a 15-second total deadline; if that read fails or times out, Tally reports the fallback and uses local history.\n- `tally run --dry-run` uses simulated workers and does not make paid model calls or write simulated spend to CFO.ai. It is not offline: when Neatlogs is enabled, route-decision traces may still be sent remotely. Use `--plan` for a no-worker, read-only preflight; it reads enabled services but does not export decision traces.\n- `tally demo --live` also uses simulated workers and does not write simulated CFO.ai spend, but it may export route-decision traces to Neatlogs when enabled. Treat that as a remote trace write, not a read-only demo.\n- **`tally run` is the approval to perform real work.** It starts the configured coding agent, uses the model account, edits a worker worktree, runs the configured verification command, and can publish a PR after verification. With cfo.ai enabled, real usage is written to the selected spend tables; if a write fails, Tally keeps a local CSV fallback. Review the task list and effective available budget before starting.\n- The run cap and CFO.ai monthly remainder are both applied. `--budget` only tightens the available amount. Spend monitoring depends on usage reported by the harness/provider; it is not a provider-side billing limit, so set a conservative cap and retain the provider's own billing controls.\n- If CFO.ai cannot be read, a preview labels that it is using `tally.yaml`'s fallback. A real run configured with a cfo.ai budget may use its explicit local fallback when the service is unreachable; that run cannot enforce the live account remainder. Restore the cfo.ai connection before starting if the live budget is the required source of truth.\n\n## What the current onboarding transcript still requires\n\nIf init says Codex hooks are not trusted, the manual `/hooks` review is still required even when the hook files were created and pushed. If you skip it, Tally intentionally keeps the associated integration off. A config flag or `doctor` result cannot replace that human decision.\n","stderr":"","aggregated_output":"# Human approval points\n\nTally keeps account access, data capture, repository changes, and paid work behind separate choices. A successful `tally doctor` check proves a connection is reachable; it does not approve hooks, capture, table creation, or a worker run.\n\n## Setup choices\n\n### `tally init`\n\nReview the final proposal before answering `Apply these changes?`. It shows the repository and base branch, tests and setup commands, models, budget, runner, integrations, and files/configuration to be written. This last confirmation writes `tally.yaml` and `.tally/install.json`; AO setup, when selected, also changes the named AO project settings. Setup and test commands execute repository code and can install dependencies.\n\nThe integration table is a selection summary, not proof that each integration is fully ready. The following steps have their own consent:\n\n- **Neatlogs project key:** `NEATLOGS_API_KEY` authorizes decision-trace export. A consented SDK probe sends synthetic probe spans. Tally stores credentials outside the repository. This key does not grant Public API history reads.\n- **Neatlogs history read:** selecting a project and saving a service-account token enables read-only history lookups. Use a project-scoped token with `context:read` for project discovery and `observability:read` for traces and spans. Tally uses the Public API's bearer token, `x-project-id`, and cursor pagination; it does not write history records remotely through this reader. See Neatlogs' [authentication and scopes](https://docs.neatlogs.com/api-reference/authentication) and [pagination contract](https://docs.neatlogs.com/api-reference/pagination).\n- **Global Neatlogs hooks:** the separate global-hook prompt installs packages globally and changes `~/.claude/settings.json` and `~/.codex/hooks.json`. These hooks can observe coding-agent sessions outside Tally, so approve only if machine-wide tracing is intended and allowed for the data on this machine. In Codex, open `/hooks`, inspect the exact Neatlogs hook definitions, and trust them yourself. Tally cannot grant that trust.\n- **Entire login and Graph plugin:** approving login starts Entire's own browser authentication; approving Graph installs its CLI plugin. These are account/machine changes and are independent of Tally's final config write.\n- **Entire repository capture:** before enabling capture, review the proposed repository files and local Git hooks. A second confirmation is required before Tally commits only the listed settings and pushes them to the repository's default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n- **Entire repository mirror:** this is a separate opt-in after capture setup. Confirm only if you want Entire to hold a copy of the GitHub repository. The Entire CLI asks which region or regions to use, and Tally verifies a mirror is ready before it adds browser session links to PRs. Declining keeps local checkpoint capture and normal runs available; hosted recall and hosted session links need a mirror. The selected region and copy are external Entire account changes.\n- **Entire Codex hooks:** after repository capture is published, open Codex in that repository, run `/hooks`, inspect the Entire hooks, and trust them yourself. If you decline or have not trusted them, init keeps Entire disabled. Tally cannot approve hooks on your behalf. See the [Codex Hooks documentation](https://learn.chatgpt.com/docs/hooks).\n- **cfo.ai login and selection:** approving connection starts cfo.ai's OAuth flow in a browser. Select the intended workspace and scenario; these determine which organization's monthly budget and spend tables Tally reads and updates.\n- **cfo.ai table creation:** if required tables are missing, Tally displays their names, rows, formulas, and starting values, then asks before creating them. Existing tables and model data are not reset. Table creation is an external cfo.ai write.\n\n## Before each run\n\n- `tally doctor` checks configured connections. It does not start workers, trust hooks, create tables, or publish repository settings.\n- `neatlogs key: connected` means the ingest key is configured; it does not prove that `NEATLOGS_TOKEN` can read the selected project's history. In a plan, `History source: remote Neatlogs` confirms a matching remote observation. `local Neatlogs fallback` means Tally used local observations; if neither source has usable data, the plan shows `none` and may include a `History note`.\n- `tally run --plan` reads the selected GitHub backlog, local repository signals, Neatlogs history when enabled, and CFO.ai budget/spend when enabled. It starts no coding agent, writes no CFO.ai spend, and creates no PR. Neatlogs history reads have a 15-second total deadline; if that read fails or times out, Tally reports the fallback and uses local history.\n- `tally run --dry-run` uses simulated workers and does not make paid model calls or write simulated spend to CFO.ai. It is not offline: when Neatlogs is enabled, route-decision traces may still be sent remotely. Use `--plan` for a no-worker, read-only preflight; it reads enabled services but does not export decision traces.\n- `tally demo --live` also uses simulated workers and does not write simulated CFO.ai spend, but it may export route-decision traces to Neatlogs when enabled. Treat that as a remote trace write, not a read-only demo.\n- **`tally run` is the approval to perform real work.** It starts the configured coding agent, uses the model account, edits a worker worktree, runs the configured verification command, and can publish a PR after verification. With cfo.ai enabled, real usage is written to the selected spend tables; if a write fails, Tally keeps a local CSV fallback. Review the task list and effective available budget before starting.\n- The run cap and CFO.ai monthly remainder are both applied. `--budget` only tightens the available amount. Spend monitoring depends on usage reported by the harness/provider; it is not a provider-side billing limit, so set a conservative cap and retain the provider's own billing controls.\n- If CFO.ai cannot be read, a preview labels that it is using `tally.yaml`'s fallback. A real run configured with a cfo.ai budget may use its explicit local fallback when the service is unreachable; that run cannot enforce the live account remainder. Restore the cfo.ai connection before starting if the live budget is the required source of truth.\n\n## What the current onboarding transcript still requires\n\nIf init says Codex hooks are not trusted, the manual `/hooks` review is still required even when the hook files were created and pushed. If you skip it, Tally intentionally keeps the associated integration off. A config flag or `doctor` result cannot replace that human decision.\n","exit_code":0,"duration":{"secs":0,"nanos":5500},"formatted_output":"# Human approval points\n\nTally keeps account access, data capture, repository changes, and paid work behind separate choices. A successful `tally doctor` check proves a connection is reachable; it does not approve hooks, capture, table creation, or a worker run.\n\n## Setup choices\n\n### `tally init`\n\nReview the final proposal before answering `Apply these changes?`. It shows the repository and base branch, tests and setup commands, models, budget, runner, integrations, and files/configuration to be written. This last confirmation writes `tally.yaml` and `.tally/install.json`; AO setup, when selected, also changes the named AO project settings. Setup and test commands execute repository code and can install dependencies.\n\nThe integration table is a selection summary, not proof that each integration is fully ready. The following steps have their own consent:\n\n- **Neatlogs project key:** `NEATLOGS_API_KEY` authorizes decision-trace export. A consented SDK probe sends synthetic probe spans. Tally stores credentials outside the repository. This key does not grant Public API history reads.\n- **Neatlogs history read:** selecting a project and saving a service-account token enables read-only history lookups. Use a project-scoped token with `context:read` for project discovery and `observability:read` for traces and spans. Tally uses the Public API's bearer token, `x-project-id`, and cursor pagination; it does not write history records remotely through this reader. See Neatlogs' [authentication and scopes](https://docs.neatlogs.com/api-reference/authentication) and [pagination contract](https://docs.neatlogs.com/api-reference/pagination).\n- **Global Neatlogs hooks:** the separate global-hook prompt installs packages globally and changes `~/.claude/settings.json` and `~/.codex/hooks.json`. These hooks can observe coding-agent sessions outside Tally, so approve only if machine-wide tracing is intended and allowed for the data on this machine. In Codex, open `/hooks`, inspect the exact Neatlogs hook definitions, and trust them yourself. Tally cannot grant that trust.\n- **Entire login and Graph plugin:** approving login starts Entire's own browser authentication; approving Graph installs its CLI plugin. These are account/machine changes and are independent of Tally's final config write.\n- **Entire repository capture:** before enabling capture, review the proposed repository files and local Git hooks. A second confirmation is required before Tally commits only the listed settings and pushes them to the repository's default branch. That push is a GitHub write and can enable checkpoint/session evidence for future workers. Declining publication leaves capture unavailable to worker worktrees until you publish the settings through your normal review process.\n- **Entire repository mirror:** this is a separate opt-in after capture setup. Confirm only if you want Entire to hold a copy of the GitHub repository. The Entire CLI asks which region or regions to use, and Tally verifies a mirror is ready before it adds browser session links to PRs. Declining keeps local checkpoint capture and normal runs available; hosted recall and hosted session links need a mirror. The selected region and copy are external Entire account changes.\n- **Entire Codex hooks:** after repository capture is published, open Codex in that repository, run `/hooks`, inspect the Entire hooks, and trust them yourself. If you decline or have not trusted them, init keeps Entire disabled. Tally cannot approve hooks on your behalf. See the [Codex Hooks documentation](https://learn.chatgpt.com/docs/hooks).\n- **cfo.ai login and selection:** approving connection starts cfo.ai's OAuth flow in a browser. Select the intended workspace and scenario; these determine which organization's monthly budget and spend tables Tally reads and updates.\n- **cfo.ai table creation:** if required tables are missing, Tally displays their names, rows, formulas, and starting values, then asks before creating them. Existing tables and model data are not reset. Table creation is an external cfo.ai write.\n\n## Before each run\n\n- `tally doctor` checks configured connections. It does not start workers, trust hooks, create tables, or publish repository settings.\n- `neatlogs key: connected` means the ingest key is configured; it does not prove that `NEATLOGS_TOKEN` can read the selected project's history. In a plan, `History source: remote Neatlogs` confirms a matching remote observation. `local Neatlogs fallback` means Tally used local observations; if neither source has usable data, the plan shows `none` and may include a `History note`.\n- `tally run --plan` reads the selected GitHub backlog, local repository signals, Neatlogs history when enabled, and CFO.ai budget/spend when enabled. It starts no coding agent, writes no CFO.ai spend, and creates no PR. Neatlogs history reads have a 15-second total deadline; if that read fails or times out, Tally reports the fallback and uses local history.\n- `tally run --dry-run` uses simulated workers and does not make paid model calls or write simulated spend to CFO.ai. It is not offline: when Neatlogs is enabled, route-decision traces may still be sent remotely. Use `--plan` for a no-worker, read-only preflight; it reads enabled services but does not export decision traces.\n- `tally demo --live` also uses simulated workers and does not write simulated CFO.ai spend, but it may export route-decision traces to Neatlogs when enabled. Treat that as a remote trace write, not a read-only demo.\n- **`tally run` is the approval to perform real work.** It starts the configured coding agent, uses the model account, edits a worker worktree, runs the configured verification command, and can publish a PR after verification. With cfo.ai enabled, real usage is written to the selected spend tables; if a write fails, Tally keeps a local CSV fallback. Review the task list and effective available budget before starting.\n- The run cap and CFO.ai monthly remainder are both applied. `--budget` only tightens the available amount. Spend monitoring depends on usage reported by the harness/provider; it is not a provider-side billing limit, so set a conservative cap and retain the provider's own billing controls.\n- If CFO.ai cannot be read, a preview labels that it is using `tally.yaml`'s fallback. A real run configured with a cfo.ai budget may use its explicit local fallback when the service is unreachable; that run cannot enforce the live account remainder. Restore the cfo.ai connection before starting if the live budget is the required source of truth.\n\n## What the current onboarding transcript still requires\n\nIf init says Codex hooks are not trusted, the manual `/hooks` review is still required even when the hook files were created and pushed. If you skip it, Tally intentionally keeps the associated integration off. A config flag or `doctor` result cannot replace that human decision.\n"},"started_at_ms":1791807495675,"completed_at_ms":1791807495675}}
{"timestamp":"2026-10-12T12:18:15.746Z","ordinal":16401,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1300c-9e42-73d2-8ac0-829916040036","call_id":"call_8d297ae5a2f54670ba6a26ca62d8727f","output":[{"type":"input_text","text":"Script completed\nWall time 8.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10482)\nTotal output lines: 2\n\n{\"chunk_id\":\"827b87\",\"wall_time_seconds\":2.861010959,\"exit_code\":0,\"original_token_count\":12350,\"output\":\"Warning: truncated output (original token count: 12350)\\nTotal output lines: 810\\n\\ndiff --git a/README.md b/README.md\\nindex 9fd185b..0b5a753 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -498,10 +498,20 @@ named by its new commits to `origin` and to an `entire` remote when configured.\\n Checkpoint upload failures are reported as publishing failures. Dry runs do\\n not publish branches or checkpoints.\\n \\n-Entire documents commit links as\\n-`https://entire.io/gh/<org>/<repo>/commit/<commit-sha>`. Tally keeps\\n-`checkpointUrl` null unless the CLI returns a URL; a local checkpoint does not\\n-by itself establish that a hosted link works.\\n+Entire checkpoint records live in separate Git refs, not on the task branch.\\n+Tally keeps the checkpoint ID and native session ID, and attaches a clickable\\n+Entire session link only when the Entire CLI confirms that the GitHub repo has\\n+a ready mirror. The link opens the session that contains the checkpoint; a\\n+reviewer still needs access to that repo in Entire. Without a ready mirror,\\n+Tally keeps the checkpoint ID available in the local ledger rather than adding\\n+a link that may not open.\\n+\\n+After each run has completed its Neatlogs read-back, Tally adds an evidence\\n+section to the generated PR body when links are available: Entire session and\\n+checkpoint, Neatlogs routing and worker traces, and the configured cfo.ai\\n+budget and spend tables. Worker trace links are added only after Tally verifies\\n+their read-back. These dashboard links use the viewer's existing account\\n+access; Tally does not publish public trace shares.\\n \\n Tally assumes nothing about the repository it works on. The repository, test\\n command, model tiers, list prices, ceilings and budget all come from\\ndiff --git a/adapters/entire-checkpoints.test.ts b/adapters/entire-checkpoints.test.ts\\nindex 1de3e8a..0c621e8 100644\\n--- a/adapters/entire-checkpoints.test.ts\\n+++ b/adapters/entire-checkpoints.test.ts\\n@@ -105,6 +105,42 @@ describe('EntireCheckpointAdapter', () => {\\n     });\\n   });\\n \\n+  it('builds an Entire session link only when the GitHub repo has a ready mirror', async () => {\\n+    const calls: string[] = [];\\n+    const adapter = new EntireCheckpointAdapter({ repoPath: '/repo', repoSlug: 'acme/widgets', command: async (_file, args) => {\\n+      calls.push(args.join(' '));\\n+      if (args[0] === 'log') return { stdout: 'fix: thing\\\\n\\\\nEntire-Checkpoint: 01M4LINK\\\\n', stderr: '' };\\n+      if (args[0] === 'checkpoint') return { stdout: JSON.stringify({ checkpoint_id: '01M4LINK', sessions: [{ session_id: 'native-session-1' }] }), stderr: '' };\\n+      if (args.join(' ') === 'repo mirror list --json --mirrored --name acme/widgets') return {\\n+        stdout: JSON.stringify([{ repo: '/gh/acme/widgets', placements: [{ status: 'ready' }] }]), stderr: '',\\n+      };\\n+      throw new Error(`unexpected Entire command: ${args.join(' ')}`);\\n+    } });\\n+    await expect(adapter.checkpointFor({ sessionId: 'worker', branch: 'task' })).resolves.toEqual({\\n+      checkpointId: '01M4LINK',\\n+      checkpointUrl: 'https://entire.io/gh/acme/widgets/session/native-session-1',\\n+      entireSessionId: 'native-session-1',\\n+    });\\n+    expect(calls).toEqual([\\n+      'log -1 --format=%B --end-of-options task --',\\n+      'checkpoint explain 01M4LINK --json --no-pager',\\n+      'repo mirror list --json --mirrored --name acme/widgets',\\n+    ]);\\n+  });\\n+\\n+  it('keeps the URL absent when Entire has no ready mirror for the repository', async () => {\\n+    const adapter = new EntireCheckpointAdapter({ repoPath: '/repo', repoSlug: 'acme/widgets', command: async (_file, args) => {\\n+      if (args[0] === 'log') return { stdout: 'fix: thing\\\\n\\\\nEntire-Checkpoint: 01M4LOCAL\\\\n', stderr: '' };\\n+      if (args[0] === 'checkpoint') return { stdout: JSON.stringify({ checkpoint_id: '01M4LOCAL', sessions: [{ session_id: 'native-session-2' }] }), stderr: '' };\\n+      return { stdout: '[]', stderr: '' };\\n+    } });\\n+    await expect(adapter.checkpointFor({ sessionId: 'worker', branch: 'task' })).resolves.toMatchObject({\\n+      checkpointId: '01M4LOCAL',\\n+      checkpointUrl: null,\\n+      entireSessionId: 'native-session-2',\\n+    });\\n+  });\\n+\\n   it('uses the worker branch trailer before an unrelated AO session and retains the native session', async () => {\\n     const calls: string[] = [];\\n     const adapter = new EntireCheckpointAdapter({ repoPath: '/root', command: async (file, args, options) => {\\ndiff --git a/adapters/entire-checkpoints.ts b/adapters/entire-checkpoints.ts\\nindex 62f6354..d16a75b 100644\\n--- a/adapters/entire-checkpoints.ts\\n+++ b/adapters/entire-checkpoints.ts\\n@@ -1,6 +1,7 @@\\n import { runCommand } from './command.js';\\n import { resolve } from 'node:path';\\n import type { CheckpointInfo, CheckpointPort, HandoffContext, HandoffPort, HandoffSummary } from '../agent/ports.js';\\n+import { entireSessionUrl } from './evidence-links.js';\\n \\n const execFileAsync = runCommand;\\n \\n@@ -13,6 +14,7 @@ export type CommandRunner = (file: string, args: string[], options?: { cwd?: str\\n \\n export interface EntireCheckpointOptions {\\n   repoPath: string;\\n+  repoSlug?: string;\\n   command?: CommandRunner;\\n   summaryTimeoutSec?: number;\\n   generatedSummaries?: boolean;\\n@@ -49,6 +51,11 @@ interface ExplainEnvelope {\\n   sessions?: Array<{ session_id?: unknown }>;\\n }\\n \\n+interface MirrorRecord {\\n+  repo?: unknown;\\n+  placements?: Array<{ status?: unknown }>;\\n+}\\n+\\n interface ResolvedCheckpoint extends CheckpointInfo {\\n   branch: string | null;\\n   filesTouched: string[];\\n@@ -102,12 +109,15 @@ export class EntireCheckpointAdapter implements HandoffPort, CheckpointPort {\\n   private readonly repoPath: string;\\n   private readonly summaryTimeoutSec: number;\\n   private readonly generatedSummaries: boolean;\\n+  private readonly repoSlug?: string;\\n+  private mirrorReadyPromise?: Promise<boolean>;\\n \\n   constructor(options: EntireCheckpointOptions) {\\n     this.command = options.command ?? defaultCommand;\\n     this.repoPath = options.repoPath;\\n     this.summaryTimeoutSec = options.summaryTimeoutSec ?? 45;\\n     this.generatedSummaries = options.generatedSummaries === true;\\n+    this.repoSlug = options.repoSlug;\\n   }\\n \\n   async checkpointFor(context: HandoffContext & { sessionId: string }): Promise<CheckpointInfo | null> {\\n@@ -211,12 +221,29 @@ export class EntireCheckpointAdapter implements HandoffPort, CheckpointPort {\\n     );\\n     const parsed = result ? parseJson<ExplainEnvelope>(result.stdout) : null;\\n     const checkpoint = checkpointId(parsed ?? {}) ?? id;\\n+    const entireSessionId = text(parsed?.sessions?.[parsed.sessions.length - 1]?.session_id);\\n+    const explicitUrl = parsed ? checkpointUrl(parsed) : null;\\n+    const hostedUrl = explicitUrl ?? (entireSessionId && await this.hasReadyMirror()\\n+      ? entireSessionUrl(this.repoSlug, entireSessionId)\\n+      : null);\\n     return {\\n       checkpointId: checkpoint,\\n-      checkpointUrl: parsed ? checkpointUrl(parsed) : null,\\n+      checkpointUrl: hostedUrl,\\n       branch: text(parsed?.branch) ?? context.branch ?? null,\\n-      entireSessionId: text(parsed?.sessions?.[parsed.sessions.length - 1]?.session_id),\\n+      entireSessionId,\\n       filesTouched: Array.isArray(parsed?.files_touched) ? parsed.files_touched.filter((file): file is string => typeof file === 'string') : [],\\n     };\\n   }\\n+\\n+  private async hasReadyMirror(): Promise<boolean> {\\n+    if (!this.repoSlug) return false;\\n+    this.mirrorReadyPromise ??= (async () => {\\n+      const result = await this.command('entire', ['repo', 'mirror', 'list', '--json', '--mirrored', '--name', this.repoSlug!], { cwd: this.repoPath }).catch(() => null);\\n+      const parsed = parseJson<MirrorRecord[] | { items?: MirrorRecord[] }>(result?.stdout ?? '');\\n+      const records = Array.isArray(parsed) ? parsed : parsed?.items ?? [];\\n+      return records.some(record => record.repo === `/gh/${this.repoSlug}`\\n+        && record.placements?.some(placement => placement.status === 'ready'));\\n+    })();\\n+    return this.mirrorReadyPromise;\\n+  }\\n }\\ndiff --git a/adapters/evidence-links.ts b/adapters/evidence-links.ts\\nnew file mode 100644\\nindex 0000000..85dc32c\\n--- /dev/null\\n+++ b/adapters/evidence-links.ts\\n@@ -0,0 +1,11 @@\\n+export function neatlogsTraceUrl(traceId: string | null | undefined): string | null {\\n+  if (!traceId || !/^[0-9a-f]{32}$/i.test(traceId)) return null;\\n+  return `https://app.neatlogs.com/traces/${traceId}`;\\n+}\\n+\\n+export function entireSessionUrl(repoSlug: string | undefined, sessionId: string | null | undefined): string | null {\\n+  if (!repoSlug || !sessionId) return null;\\n+  const parts = repoSlug.split('/');\\n+  if (parts.length !== 2 || parts.some(part => !part || part === '.' || part === '..')) return null;\\n+  return `https://entire.io/gh/${parts.map(encodeURIComponent).join('/')}/session/${encodeURIComponent(sessionId)}`;\\n+}\\ndiff --git a/adapters/publisher.test.ts b/adapters/publisher.test.ts\\nindex 94d67b0..e1a49bb 100644\\n--- a/adapters/publisher.test.ts\\n+++ b/adapters/publisher.test.ts\\n@@ -1,5 +1,5 @@\\n import { describe, expect, it } from 'vitest';\\n-import { GitHubPublisher, type PublishCommand 