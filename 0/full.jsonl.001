n      \\\"runtime\\\": \\\"default\\\",\\n      \\\"label\\\": \\\"0.1.0 upgrade\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"default\\\",\\n      \\\"label\\\": \\\"0.2.0 upgrade\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"version\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"logo non-TTY\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"demo\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"doctor scratch\\\",\\n      \\\"exit\\\": 1\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"init help\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"plan\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"doctor configured\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"market replay\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"0.1.0 upgrade\\\",\\n      \\\"exit\\\": 0\\n    },\\n    {\\n      \\\"runtime\\\": \\\"node20\\\",\\n      \\\"label\\\": \\\"0.2.0 upgrade\\\",\\n      \\\"exit\\\": 0\\n    }\\n  ]\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"9dc8e3\",\"wall_time_seconds\":0.000012416,\"exit_code\":0,\"original_token_count\":4817,\"output\":\"Warning: truncated output (original token count: 4817)\\nTotal output lines: 292\\n\\n\\u001b[10A\\r\\u001b[2K    ▄   █\\r\\n\\r\\u001b[2K    █   █\\r\\n\\r\\u001b[2K    █   █\\r\\n\\r\\u001b[2K    █   ▀\\r\\n\\r\\u001b[2K    █\\r\\n\\r\\u001b[2K    █\\r\\n\\r\\u001b[2K    █\\r\\n\\r\\u001b[2K    █\\r\\n\\r\\u001b[2K    █\\r\\n\\