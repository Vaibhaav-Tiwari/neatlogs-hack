scopeArgs(),\n        update: {\n          target: this.config.table,\n          values: { columns: [this.monthColumn()], rows: [[this.config.spendRow, usd]] },\n        },\n      });\n      if (!successfulEdit(result)) {\n        throw new Error('cfo.ai did not apply the spend update');\n      }\n      const readBack = usdToNanos(await this.readUsd(this.config.spendRow));\n      if (Math.abs(readBack - total) > 1) {\n        throw new Error('cfo.ai spend read-back did not match the applied update');\n        attempt: row.attempt,\n        nativeSessionId,\n      }).catch(() => null);\n      if (workerTraceId) {\n        row.workerTraceId = workerTraceId;\n        delete row.workerTraceDetail;\n        recoveredWorkerTraceAttempts.add(`${row.taskId}/${row.attempt}`);\n        continue;\n      }\n      const readDetail = ports.workerTraceReader.status?.().detail;\n      const retryDetail = [drainStatus?.detail, readDetail].filter((detail): detail is string => Boolean(detail)).join('; ')\n        || 'worker trace read-back is still unverified';\n      row.workerTraceDetail = [\n        row.workerTraceDetail ? `Initial delivery attempt: ${row.workerTraceDetail}` : null,\n        `Post-worker retry: ${retryDetail}`,\n        `Recover with \\`tally traces drain --run ${row.runId}\\`.`,\n      ].filter((detail): detail is string => Boolean(detail)).join('; ');\n    }\n  }\n\n  await (ports.trace as (TracePort & { flush?: () => Promise<void> }) | undefined)?.flush?.();\n  for (const row of ledger) {\n    if (config.integrations.neatlogs) {\n      row.traceUrl ??= neatlogsTraceUrl(row.traceId);\n      row.workerTraceUrl ??= neatlogsTraceUrl(row.workerTraceId);\n    }\n  }\n\n  let evidenceUpdateFailure: string | null = null;\n  if (!options.dryRun && ports.publisher.updatePrEvidence) {\n    const publishedRows = new Map(ledger.filter(row => row.prUrl).map(row => [row.prUrl!, row]));\n    for (const [prUrl, row] of publishedRows) {\n      const links = prEvidenceLinks(row, config);\n      if (!links.length) continue;\n      try {\n        await ports.publisher.updatePrEvidence({ config, prUrl, links });\n      } catch (error) {\n        const detail = error instanceof Error ? error.message : String(error);\n        evidenceUpdateFailure ??= `PR evidence links could not be attached to ${prUrl}: ${detail}`;\n      }\n    }\n  }\n\n  const endedAt = now().toISOString();\n  const runState = writeCurrent(stopRequested() ? 'interrupted' : 'finished', endedAt);\n  if (evidenceUpdateFailure) {\n    runState.integrations.github = { status: 'error', detail: evidenceUpdateFailure };\n  }\n  const paths = writeRunFiles(outputDir, runState, ledger, options.latestRunDir);\n  return { runState, ledger, ...paths };\n}\n}\n\nexport type Ledger = LedgerRow[];\n\nexport type RunMode = 'tally' | 'baseline';\nexport type RunStatus = 'running' | 'finished' | 'interrupted';\nexport type TaskStatus = 'pending' | 'running' | 'passed' | 'failed' | 'skipped';\nexport type BudgetSource = 'config' | 'cfoai';\n\nexport type IntegrationName = 'neatlogs' | 'entire' | 'cfoai' | 'github' | 'slack';\n/** `off` = switched off in config, `missing` = on but not usable, `error` = failed during the run. */\nexport type IntegrationStatus = 'ok' | 'off' | 'missing' | 'error';\n\nexport interface IntegrationState {\n  status: IntegrationStatus;\n  /** What Tally does instead, or what went wrong. */\n  detail: string | null;\n}\n\nexport interface TaskImpact {\n  source: 'entire-graph' | 'code-search' | 'scripted' | 'none';\n  query: string;\n  nodes: Array<{ id: string; kind: 'target' | 'caller' | 'coChange' | 'test'; symbol?: string; weight?: number }>;\n  edges: Array<{ from: string; to: string; kind: 'calls' | 'changesWith' | 'tests' }>;\n  totals: { filesTouched: number; dependents: number; testsPresent: boolean; nodes: number; edges: number };\n  truncated: boolean;\n}\n\nexport interface TaskState {\n  taskId: string;\n  title: string;\n  issueNumber: number | null;\n  issueUrl: string | null;\n  /** null until the sizer has run. */\n  size: TaskSize | null;\n  /** Sizer confidence for the selected size, retained for CFO context. */\n  sizingConfidence?: number;\n  impact?: TaskImpact;\n  changedFiles?: string[];\n  status: TaskStatus;\n  /** Why a task is failed or skipped, e.g. \"not started: no budget\". */\n  statusReason: string | null;\n  attempts: number;\n  /** Tier of the latest attempt. */\n  tier: string | null;\n  model: string | null;\n  spentNanos: number;\n  escalated: boolean;\n  prUrl: string | null;\n}\n\nexport interface RunState {\n  schemaVersion: 1;\n  runId: string;\n  mode: RunMode;\n  repeat?: number;\n  /** True when workers were simulated and nothing was spent. */\n  dryRun: boolean;\n  status: RunStatus;\n  /** The repository the run worked on, as written in tally.yaml. */\n  repo: string;\n  backlog?: { source: 'github-issues' | 'file'; issueLabel?: string; file?: string };\n  /** Commit every task branched from. */\n  baseCommit: string | null;\n  startedAt: string;\n  updatedAt: string;\n  endedAt: string | null;\n  budget: {\n    source: BudgetSource;\n    monthly?: { source: BudgetSource; limitNanos: number; spentBeforeRunNanos: number };\n    /** Origin of this run's effective limit, distinct from spend accounting. */\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1300b-17e6-7e20-bf7a-c9594d868dc3","create_time":1791809056.8612604}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
