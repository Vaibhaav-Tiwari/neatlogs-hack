{"timestamp":"2026-10-12T19:31:12.903Z","ordinal":16920,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a125af-5d46-7871-9bed-a128df2c2957","turn_id":"01a13198-29de-7b21-baeb-0750d37549c2","item":{"type":"FileChange","id":"exec-1289e869-5cf9-4632-89a9-fd62486afe83","changes":{"/private/tmp/tally-021-check.mjs":{"type":"update","unified_diff":"@@ -4,6 +4,9 @@\n import path from 'node:path';\n-const root=fs.mkdtempSync('/private/tmp/tally-020b-check.');\n-const out='/Users/vaibhaav/.ao/data/artifacts/neatlogs-hack-5/release-020b';\n-const release='78885aada7f9769b632c419567de77803216d72f';\n-const source='afbd3769aac4b5be24489591a7da19d1e1f917b0';\n+const root=fs.mkdtempSync('/private/tmp/tally-021-check.');\n+const out='/Users/vaibhaav/.ao/data/artifacts/neatlogs-hack-5/release-021';\n+const release=process.argv[2];\n+if(!release||!/^[0-9a-f]{40}$/.test(release))throw Error('Specify exact built release hash');\n+const source='ceddd6a23e7d57dd69f5ba240aa34218647a47c2';\n+const assertMain=()=>{const remote=exec('git',['ls-remote','origin','refs/heads/main'],{encoding:'utf8'}).split(/\\s+/)[0];if(remote!==source)throw Error('STOP: main moved to '+remote);};\n+assertMain();\n fs.mkdirSync(out,{recursive:true}); fs.mkdirSync(path.join(root,'release'));\n@@ -13,3 +16,3 @@\n fs.writeFileSync(path.join(out,'inventory.json'),JSON.stringify(inventory,null,2));\n-for(const file of inventory.files){if(/(^|\\/)(site|scripts|testing|node_modules|\\.tally|\\.claude|\\.codex)(\\/|$)|\\.test\\.|(^|\\/)\\.env($|\\.)/.test(file.path))throw Error('forbidden packed file '+file.path);}\n+for(const file of inventory.files){if(/(^|\\/)(site|scripts|test|testing|node_modules|\\.tally|\\.claude|\\.codex)(\\/|$)|\\.test\\.|external-services-guard|real-runs-guard|(^|\\/)\\.env($|\\.)/.test(file.path))throw Error('forbidden packed file '+file.path);}\n for(const file of ['bin/tally.js','dashboard/index.html','schema/tally-config.schema.json','README.md','LICENSE','release-source.json'])if(!inventory.files.some(f=>f.path===file))throw Error('missing '+file);\n@@ -31,2 +34,3 @@\n for(const [name,node] of runtimes){\n+ assertMain();\n  const prefix=path.join(root,'prefix-'+name),cache=path.join(root,'cache-'+name); fs.mkdirSync(prefix);fs.mkdirSync(cache);\n@@ -39,4 +43,7 @@\n  const upgrade=exec(node,['--input-type=module','-e',script],{cwd:scratch,encoding:'utf8',timeout:30000,env:{...process.env,HOME:path.join(root,'home')}});checks.push({runtime:name,label:'0.1.0 upgrade',exit:0,output:upgrade});\n+ const modern=script.replace(JSON.stringify(path.join(scratch,'legacy.yaml')),JSON.stringify(path.join(scratch,'plan.yaml'))).replace('assert.equal(config.parallelWorkers,undefined);assert.equal(config.modelAccessFallbackTier,undefined);','assert.equal(config.parallelWorkers,2);assert.equal(config.modelAccessFallbackTier,\"middle\");').replaceAll('upgrade-'+name,'upgrade-020-'+name).replaceAll('latest-'+name,'latest-020-'+name).replace(\"assert.deepEqual(events,['start','end','start','end']);\",\"assert.equal(events.filter(e=>e==='start').length,2);assert.equal(events.filter(e=>e==='end').length,2);\").replace('Unchanged 0.1.0 config: two tasks passed sequentially','Unchanged 0.2.0 config: new fields retained, two tasks passed');\n+ const upgraded020=exec(node,['--input-type=module','-e',modern],{cwd:scratch,encoding:'utf8',timeout:30000,env:{...process.env,HOME:path.join(root,'home')}});checks.push({runtime:name,label:'0.2.0 upgrade',exit:0,output:upgraded020});\n  console.log(name+' install and command checks passed');\n }\n+assertMain();\n const result={root,source,release,tarball,files:inventory.entryCount,size:inventory.size,unpackedSize:inventory.unpackedSize,sha256,checks};fs.writeFileSync(path.join(root,'results.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({...result,checks:checks.map(({runtime,label,exit})=>({runtime,label,exit}))},null,2));\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /private/tmp/tally-021-check.mjs\n","stderr":""},"started_at_ms":1791833472881,"completed_at_ms":1791833472903}}
