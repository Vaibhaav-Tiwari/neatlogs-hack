end - middle', 'Tier spend - top', 'Run spend - current', 'Run spend - cumulative'];\n function block(name: string, rows: string[]): Obj {\n@@ -81,7 +81,8 @@ describe('cfo.ai onboarding', () => {\n       tierSpendRows: { cheap: 'Tier spend - cheap', middle: 'Tier spend - middle', top: 'Tier spend - top' } });\n     expect(client.calls.filter(c => c.name.startsWith('edit'))).toEqual([]);\n     expect(login).not.toHaveBeenCalled();\n-    expect(ctx.ui.confirm).not.toHaveBeenCalled();\n+    expect(ctx.ui.confirm).toHaveBeenCalledOnce();\n+    expect(vi.mocked(ctx.ui.confirm).mock.calls[0]?.[0]).toContain('organization memory');\n     expect(ctx.config.budget.source).toBe('config');\n     const complete = { ...ctx.config, budget: result.budget, integrations: { ...ctx.config.integrations, cfoai: true } };\n     expect(validateConfig(complete)).toMatchObject({ ok: true });\n@@ -158,6 +159,37 @@ describe('cfo.ai onboarding', () => {\n     expect(client.calls.some(c => c.name.startsWith('edit'))).toBe(false);\n   });\n \n+  it('enables detailed Ari context only after a separate shared-memory consent', async () => {\n+    const { module } = setup();\n+    const ctx = context([true]);\n+    const result = await module.configure(ctx);\n+    expect(result.enabled).toBe(true);\n+    expect(result.budget?.cfoai?.publishRunContext).toBe(true);\n+    const messages = vi.mocked(ctx.ui.print).mock.calls.map(([line]) => line).join('\\n');\n+    expect(messages).toContain('Ari task context (optional)');\n+    expect(messages).toContain('shared with members of this cfo.ai workspace');\n+    expect(vi.mocked(ctx.ui.confirm).mock.calls[0]?.[0]).toBe('Share per-attempt reports with Ari’s organization memory?');\n+  });\n+\n+  it('keeps CFO tables connected while leaving Ari organization memory off by default', async () => {\n+    const { module } = setup();\n+    const ctx = context([false]);\n+    const result = await module.configure(ctx);\n+    expect(result.enabled).toBe(true);\n+    expect(result.budget?.cfoai?.publishRunContext).toBeUndefined();\n+  });\n+\n+  it('keeps table budgeting available when the server lacks the organization memory tool', async () => {\n+    const { module, client } = setup();\n+    client.listTools = async () => ({ tools: tools.filter(name => name !== 'edit_memory').map(name => ({ name, inputSchema: { type: 'object' } })) });\n+    const ctx = context();\n+    const result = await module.configure(ctx);\n+    expect(result.enabled).toBe(true);\n+    expect(result.budget?.cfoai?.publishRunContext).toBeUndefined();\n+    expect(ctx.ui.confirm).not.toHaveBeenCalled();\n+    expect(vi.mocked(ctx.ui.print).mock.calls.join(' ')).toContain('Ari task context is unavailable');\n+  });\n+\n   it('does not create any table when creation is declined', async () => {\n     const { module, client } = setup();\n     client.blocks = [];\ndiff --git a/schema/types.ts b/schema/types.ts\nindex eea828b..60edad4 100644\n--- a/schema/types.ts\n+++ b/schema/types.ts\n@@ -152,6 +152,8 @@ export interface TaskState {\n   issueUrl: string | null;\n   /** null until the sizer has run. */\n   size: TaskSize | null;\n+  /** Sizer confidence for the selected size, retained for CFO context. */\n+  sizingConfidence?: number;\n   impact?: TaskImpact;\n   changedFiles?: string[];\n   status: TaskStatus;\n@@ -271,12 +273,16 @@ export interface TallyConfig {\n       /** cfo.ai org/workspace id, e.g. \"<cfoai-org-id>\". */\n       orgId?: string;\n       scenario?: string;\n+      /** cfo.ai page containing the budget and Tally's Ari interpretation note. */\n+      pageName?: string;\n       table?: string;\n       budgetRow?: string;\n       spendRow?: string;\n       remainingRow?: string;\n       spendDetailTable?: string;\n       spendDetailTableUrl?: string;\n+      /** Share per-attempt operating context with the selected cfo.ai workspace memory for Ari. */\n+      publishRunContext?: boolean;\n       tierSpendRows?: Record<string, string>;\n       runSpendRow?: string;\n       cumulativeRunSpendRow?: string;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1300b-17e6-7e20-bf7a-c9594d868dc3","create_time":1791809040.250091}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
