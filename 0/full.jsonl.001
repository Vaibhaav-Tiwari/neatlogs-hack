assAssignments.has(absolute) && passAssignments.get(absolute) !== pass) throw new Error('One run path cannot belong to two comparison passes');\n41:const seen = new Set(), tasks = [], attempts = [], exclusions = [], sources = [], closedRuns = [];\n62:  attempts.push(...ledger.filter(row => row.runId === run.runId && row.costSource !== 'simulated' && !row.attemptId.endsWith(':handoff')));\n64:const comparison = plan ? comparisonEvidence(plan, closedRuns) : null;\n65:if (comparison) {\n66:  for (const observation of comparison.observations) {\n106:  for (const row of attempts) {\n122:const eligible = (comparison ? comparison.observations : tasks).filter(task => task.passed && !task.errored);\n127:const signalsByPass = comparison ? ['A', 'B', 'C'].flatMap(pass => signals.map(signal => ({ pass, key: signal.key, label: signal.label,\n128:  ...correlate(eligible.filter(task => task.comparisonPass === pass).map(task => [task[signal.key], task.costNanos / 1e9])) }))) : [];\n129:const matched = attempts.filter(row => readback.history.some(history => history.runId === row.runId && history.size === row.size\n131:const reportData = { generatedAt: new Date().toISOString(), sources, exclusions, cohorts, signals, signalsByPass, comparison, tasks,\n133:    verifiedWorkers: attempts.filter(row => readback.workers.some(worker => worker.attemptId === row.attemptId && worker.traceId === row.workerTraceId && worker.verified)).length,\n134:    availableWorkerIds: attempts.filter(row => row.workerTraceId).length,\n138:const keys = ['runId', 'repo', 'taskId', 'cohort', 'comparisonPass', 'decision', 'costNanos', 'passed', 'errored', 'skipped', 'attempts', 'size', 'graphNodes', 'filesTouched', 'issueLength', 'filesNamed', 'textSource', 'signalSource', 'models', 'source'];\n144:  const chartRows = comparison ? comparison.summaries.map(row => ({ ...row, cohort: { A: 'A: top baseline', B: 'B: Tally v1', C: 'C: Tally v2' }[row.pass], tasks: row.outcomes })) : cohorts;\n152:  const caption = comparison ? 'Same tasks and pinned base; partial coverage is not a completed comparison. One repeat gives no spread.'\n153:    : 'Observed task executions; different repos, models and setup histories. Not a causal savings comparison.';\n154:  await writeFile(join(out, file), svg(title, comparison ? 310 : 390, body + `<text x=\"24\" y=\"${comparison ? 280 : 365}\">${caption}</text>`));\n156:if (comparison) {\n158:  const maximum = Math.max(...comparison.rows.flatMap(row => ['A', 'B', 'C'].map(pass => average(row[pass]) ?? 0)), 0.01);\n160:  const body = comparison.rows.map((row, index) => {\n168:  const height = 120 + comparison.rows.length * 72;\n179:  const points = rows.map(row => `<circle cx=\"${x0 + row[signal.key] / maxX * 330}\" cy=\"${y0 + 180 - row.costNanos / 1e9 / maxY * 165}\" r=\"4\" fill=\"${{ A: '#356bbb', B: '#ae4739', C: '#187d5b' }[row.comparisonPass] ?? '#187d5b'}\"><title>${escape(`${row.comparisonPass ?? ''} ${row.runId}/${row.taskId}, $${(row.costNanos / 1e9).toFixed(5)}`)}</title></circle>`).join('');\n182:await writeFile(join(out, 'size-cost.svg'), svg('Sizing signals versus completed-task estimated cost', 650, scatter + `<text x=\"24\" y=\"625\">${comparison ? 'A blue: baseline; B red: v1; C green: v2. Matched plan signals; repeats are not independent samples.' : 'Successful task executions only; small, selected sample. Text may be reconstructed from current issue bodies.'}</text>`));\n185:const outcomeCell = outcomes => outcomes.length ? outcomes.map(row => `$${(row.costNanos / 1e9).toFixed(5)} / ${row.passed ? 'passed' : row.skipped ? 'skipped' : row.errored ? 'error' : 'failed'} / ${row.attempts} attempts (${row.runId})`).join('<br>') : 'pending';\n186:const comparisonLines = comparison ? [\n187:  '## Three-Pass Comparison', '', `Plan measured ${comparison.measuredAt ?? 'date unavailable'}, pinned base ${comparison.baseCommit}. Signals source: ${comparisonDir}/mentor-comparison-plan-signals.json.`, '',\n189:  ...comparison.summaries.map(row => `| ${row.pass}: ${{ A: 'top-tier baseline', B: 'Tally v1 (priors)', C: 'Tally v2 (trace history)' }[row.pass]} | ${row.coveredTasks}/${row.plannedTasks} | ${row.outcomes} | ${row.meanCostUsd === null ? 'pending' : row.meanCostUsd.toFixed(5)} | ${row.successRate === null ? 'pending' : (row.successRate * 100).toFixed(1) + '%'} | ${row.outcomes ? row.attempts : 'pending'} |`), '',\n190:  '| Task | Size | Targets | Dependents | Graph nodes | Text chars | Named paths | A: cost/verdict/attempts | B: cost/verdict/attempts | C: cost/verdict/attempts |',\n192:  ...comparison.rows.map(row => `| ${row.taskId} | ${row.size} | ${row.filesTouched} | ${row.dependents ?? 'unmeasured'} | ${row.graphNodes ?? 'unmeasured'} | ${row.issueLength} | ${row.filesNamed} | ${outcomeCell(row.A)} | ${outcomeCell(row.B)} | ${outcomeCell(row.C)} |`), '',\n193:  '![Cost per comparison task](cost-by-routing.svg)', '', '![Pass rate per comparison pass](success-by-routing.svg)', '',\n194:  'Pass labels are explicit experiment assignments, not proof that history affected every route in C. Actual routing provenance remains in tasks.csv. Costs only come from matching real ledgers; plan signals never supply spend. Missing passes/tasks stay pending; partial coverage is not a completed comparison. No savings claim before all three passes cover the same tasks. A single repeat establishes no statistical spread.', '',\n195:  `Comparison join exclusions: ${comparison.excluded.length} (base/text/pass-label mismatches retained in results.json).`, '',\n203:  ...comparisonLines,\n204:  comparison ? '## Historical Audit (Not the Matched Comparison)' : '## Before and after', '',\n208:  ...(!comparison ? ['![Estimated cost by routing](cost-by-routing.svg)', '', '![Success rate by routing](success-by-routing.svg)', ''] : []),\n210:  'No v1/v2 savings claim or baseline comparison is valid until both have measured, matched tasks. Missing cohorts mean not measured, never zero cost or 0% success. Closed interrupted runs and skipped tasks stay in the denominator; zero spend on an unstarted task is not savings. Repeated issues across runs are not independent experiments.', '',\n214:  ...(comparison ? ['| Pass | Signal | Successful pairs | Pearson r | Spearman rho |', '|---|---|---:|---:|---:|',\n216:    'The size chart uses only comparison outcomes at the pinned base with measured plan signals, not unrelated historical tasks. Pooled correlations mix model prices; per-pass coefficients are also reported. Repeated tasks across passes are not independent observations. New target files and named context can make graph targets differ from literal file mentions.', ''] : []),\n218:  'Graph nodes and target-file counts come only from saved impact totals; missing historical graphs are not reconstructed or replaced with actual edited files. Current issue bodies are labelled current-issue, not run-start snapshots. Most historical successful tasks are small documentation changes; the planned five-task comparison broadens scope but remains a tiny single-repository sample. Model price, caching, setup and repository differences confound these correlations; do not use them to train or claim a general cost predictor.', '',\n220:  `Readback date: ${readback.retrievedAt ?? 'not performed'}. ${matched.length}/${attempts.length} attempt costs/outcomes match a neatlogs history record by run, size, tier, result and integer cost.`,\n","stderr":"","aggregated_output":"4:import { comparisonEvidence } from '../dist/agent/comparison-evidence.js';\n11:if (args.includes('--help') || (!option('--manifest') && !option('--comparison-dir')) || !option('--out')) {\n12:  console.log('Usage: npm run build, then node scripts/routing-evidence.mjs [--manifest runs.json] [--comparison-dir <folder>] --out <directory> [--issues issues.json] [--live-traces]');\n19:const comparisonDir = option('--comparison-dir') ? resolve(option('--comparison-dir')) : null;\n22:if (comparisonDir) {\n23:  plan = JSON.parse(await readFile(join(comparisonDir, 'mentor-comparison-plan-signals.json'), 'utf8'));\n25:  const passFile = option('--comparison-passes') ? resolve(option('--comparison-passes')) : join(comparisonDir, 'comparison-passes.json');\n27:  catch (error) { if (error.code !== 'ENOENT' || option('--comparison-passes')) throw error; }\n28:  if (!passes || typeof passes !== 'object' || Array.isArray(passes)) throw new Error('comparison-passes.json must be an A/B/C object');\n30:    if (!['A', 'B', 'C'].includes(pass) || !Array.isArray(paths) || paths.some(path => typeof path !== 'string')) throw new Error('Comparison pass must be A/B/C with an array of run paths');\n32:      const absolute = resolve(comparisonDir, path);\n33:      if (passAssignments.has(absolute) && passAssignments.get(absolute) !== pass) throw new Error('One run path cannot belong to two comparison passes');\n41:const seen = new Set(), tasks = [], attempts = [], exclusions = [], sources = [], closedRuns = [];\n62:  attempts.push(...ledger.filter(row => row.runId === run.runId && row.costSource !== 'simulated' && !row.attemptId.endsWith(':handoff')));\n64:const comparison = plan ? comparisonEvidence(plan, closedRuns) : null;\n65:if (comparison) {\n66:  for (const observation of comparison.observations) {\n106:  for (const row of attempts) {\n122:const eligible = (comparison ? comparison.observations : tasks).filter(task => task.passed && !task.errored);\n127:const signalsByPass = comparison ? ['A', 'B', 'C'].flatMap(pass => signals.map(signal => ({ pass, key: signal.key, label: signal.label,\n128:  ...correlate(eligible.filter(task => task.comparisonPass === pass).map(task => [task[signal.key], task.costNanos / 1e9])) }))) : [];\n129:const matched = attempts.filter(row => readback.history.some(history => history.runId === row.runId && history.size === row.size\n131:const reportData = { generatedAt: new Date().toISOString(), sources, exclusions, cohorts, signals, signalsByPass, comparison, tasks,\n133:    verifiedWorkers: attempts.filter(row => readback.workers.some(worker => worker.attemptId === row.attemptId && worker.traceId === row.workerTraceId && worker.verified)).length,\n134:    availableWorkerIds: attempts.filter(row => row.workerTraceId).length,\n138:const keys = ['runId', 'repo', 'taskId', 'cohort', 'comparisonPass', 'decision', 'costNanos', 'passed', 'errored', 'skipped', 'attempts', 'size', 'graphNodes', 'filesTouched', 'issueLength', 'filesNamed', 'textSource', 'signalSource', 'models', 'source'];\n144:  const chartRows = comparison ? comparison.summaries.map(row => ({ ...row, cohort: { A: 'A: top baseline', B: 'B: Tally v1', C: 'C: Tally v2' }[row.pass], tasks: row.outcomes })) : cohorts;\n152:  const caption = comparison ? 'Same tasks and pinned base; partial coverage is not a completed comparison. One repeat gives no spread.'\n153:    : 'Observed task executions; different repos, models and setup histories. Not a causal savings comparison.';\n154:  await writeFile(join(out, file), svg(title, comparison ? 310 : 390, body + `<text x=\"24\" y=\"${comparison ? 280 : 365}\">${caption}</text>`));\n156:if (comparison) {\n158:  const maximum = Math.max(...comparison.rows.flatMap(row => ['A', 'B', 'C'].map(pass => average(row[pass]) ?? 0)), 0.01);\n160:  const body = comparison.rows.map((row, index) => {\n168:  const height = 120 + comparison.rows.length * 72;\n179:  const points = rows.map(row => `<circle cx=\"${x0 + row[signal.key] / maxX * 330}\" cy=\"${y0 + 180 - row.costNanos / 1e9 / maxY * 165}\" r=\"4\" fill=\"${{ A: '#356bbb', B: '#ae4739', C: '#187d5b' }[row.comparisonPass] ?? '#187d5b'}\"><title>${escape(`${row.comparisonPass ?? ''} ${row.runId}/${row.taskId}, $${(row.costNanos / 1e9).toFixed(5)}`)}</title></circle>`).join('');\n182:await writeFile(join(out, 'size-cost.svg'), svg('Sizing signals versus completed-task estimated cost', 650, scatter + `<text x=\"24\" y=\"625\">${comparison ? 'A blue: baseline; B red: v1; C green: v2. Matched plan signals; repeats are not independent samples.' : 'Successful task executions only; small, selected sample. Text may be reconstructed from current issue bodies.'}</text>`));\n185:const outcomeCell = outcomes => outcomes.length ? outcomes.map(row => `$${(row.costNanos / 1e9).toFixed(5)} / ${row.passed ? 'passed' : row.skipped ? 'skipped' : row.errored ? 'error' : 'failed'} / ${row.attempts} attempts (${row.runId})`).join('<br>') : 'pending';\n186:const comparisonLines = comparison ? [\n187:  '## Three-Pass Comparison', '', `Plan measured ${comparison.measuredAt ?? 'date unavailable'}, pinned base ${comparison.baseCommit}. Signals source: ${comparisonDir}/mentor-comparison-plan-signals.json.`, '',\n189:  ...comparison.summaries.map(row => `| ${row.pass}: ${{ A: 'top-tier baseline', B: 'Tally v1 (priors)', C: 'Tally v2 (trace history)' }[row.pass]} | ${row.coveredTasks}/${row.plannedTasks} | ${row.outcomes} | ${row.meanCostUsd === null ? 'pending' : row.meanCostUsd.toFixed(5)} | ${row.successRate === null ? 'pending' : (row.successRate * 100).toFixed(1) + '%'} | ${row.outcomes ? row.attempts : 'pending'} |`), '',\n190:  '| Task | Size | Targets | Dependents | Graph nodes | Text chars | Named paths | A: cost/verdict/attempts | B: cost/verdict/attempts | C: cost/verdict/attempts |',\n192:  ...comparison.rows.map(row => `| ${row.taskId} | ${row.size} | ${row.filesTouched} | ${row.dependents ?? 'unmeasured'} | ${row.graphNodes ?? 'unmeasured'} | ${row.issueLength} | ${row.filesNamed} | ${outcomeCell(row.A)} | ${outcomeCell(row.B)} | ${outcomeCell(row.C)} |`), '',\n193:  '![Cost per comparison task](cost-by-routing.svg)', '', '![Pass rate per comparison pass](success-by-routing.svg)', '',\n194:  'Pass labels are explicit experiment assignments, not proof that history affected every route in C. Actual routing provenance remains in tasks.csv. Costs only come from matching real ledgers; plan signals never supply spend. Missing passes/tasks stay pending; partial coverage is not a completed comparison. No savings claim before all three passes cover the same tasks. A single repeat establishes no statistical spread.', '',\n195:  `Comparison join exclusions: ${comparison.excluded.length} (base/text/pass-label mismatches retained in results.json).`, '',\n203:  ...comparisonLines,\n204:  comparison ? '## Historical Audit (Not the Matched Comparison)' : '## Before and after', '',\n208:  ...(!comparison ? ['![Estimated cost by routing](cost-by-routing.svg)', '', '![Success rate by routing](success-by-routing.svg)', ''] : []),\n210:  'No v1/v2 savings claim or baseline comparison is valid until both have measured, matched tasks. Missing cohorts mean not measured, never zero cost or 0% success. Closed interrupted runs and skipped tasks stay in the denominator; zero spend on an unstarted task is not savings. Repeated issues across runs are not independent experiments.', '',\n214:  ...(comparison ? ['| Pass | Signal | Successful pairs | Pearson r | Spearman rho |', '|---|---|---:|---:|---:|',\n216:    'The size chart uses only comparison outcomes at the pinned base with measured plan signals, not unrelated historical tasks. Pooled correlations mix model prices; per-pass coefficients are also reported. Repeated tasks across passes are not independent observations. New target files and named context can make graph targets differ from literal file mentions.', ''] : []),\n218:  'Graph nodes and target-file counts come only from saved impact totals; missing historical graphs are not reconstructed or replaced with actual edited files. Current issue bodies are labelled current-issue, not run-start snapshots. Most historical successful tasks are small documentation changes; the planned five-task comparison broadens scope but remains a tiny single-repository sample. Model price, caching, setup and repository differences confound these correlations; do not use them to train or claim a general cost predictor.', '',\n220:  `Readback date: ${readback.retrievedAt ?? 'not performed'}. ${matched.length}/${attempts.length} attempt costs/outcomes match a neatlogs history record by run, size, tier, result and integer cost.`,\n","exit_code":0,"duration":{"secs":0,"nanos":4666},"formatted_output":"4:import { comparisonEvidence } from '../dist/agent/comparison-evidence.js';\n11:if (args.includes('--help') || (!option('--manifest') && !option('--comparison-dir')) || !option('--out')) {\n12:  console.log('Usage: npm run build, then node scripts/routing-evidence.mjs [--manifest runs.json] [--comparison-dir <folder>] --out <directory> [--issues issues.json] [--live-traces]');\n19:const comparisonDir = option('--comparison-dir') ? resolve(option('--comparison-dir')) : null;\n22:if (comparisonDir) {\n23:  plan = JSON.parse(await readFile(join(comparisonDir, 'mentor-comparison-plan-signals.json'), 'utf8'));\n25:  const passFile = option('--comparison-passes') ? resolve(option('--comparison-passes')) : join(comparisonDir, 'comparison-passes.json');\n27:  catch (error) { if (error.code !== 'ENOENT' || option('--comparison-passes')) throw error; }\n28:  if (!passes || typeof passes !== 'object' || Array.isArray(passes)) throw new Error('comparison-passes.json must be an A/B/C object');\n30:    if (!['A', 'B', 'C'].includes(pass) || !Array.isArray(paths) || paths.some(path => typeof path !== 'string')) throw new Error('Comparison pass must be A/B/C with an array of run paths');\n32:      const absolute = resolve(comparisonDir, path);\n33:      if (passAssignments.has(absolute) && passAssignments.get(absolute) !== pass) throw new Error('One run path cannot belong to two comparison passes');\n41:const seen = new Set(), tasks = [], attempts = [], exclusions = [], sources = [], closedRuns = [];\n62:  attempts.push(...ledger.filter(row => row.runId === run.runId && row.costSource !== 'simulated' && !row.attemptId.endsWith(':handoff')));\n64:const comparison = plan ? comparisonEvidence(plan, closedRuns) : null;\n65:if (comparison) {\n66:  for (const observation of comparison.observations) {\n106:  for (const row of attempts) {\n122:const eligible = (comparison ? comparison.observations : tasks).filter(task => task.passed && !task.errored);\n127:const signalsByPass = comparison ? ['A', 'B', 'C'].flatMap(pass => signals.map(signal => ({ pass, key: signal.key, label: signal.label,\n128:  ...correlate(eligible.filter(task => task.comparisonPass === pass).map(task => [task[signal.key], task.costNanos / 1e9])) }))) : [];\n129:const matched = attempts.filter(row => readback.history.some(history => history.runId === row.runId && history.size === row.size\n131:const reportData = { generatedAt: new Date().toISOString(), sources, exclusions, cohorts, signals, signalsByPass, comparison, tasks,\n133:    verifiedWorkers: attempts.filter(row => readback.workers.some(worker => worker.attemptId === row.attemptId && worker.traceId === row.workerTraceId && worker.verified)).length,\n134:    availableWorkerIds: attempts.filter(row => row.workerTraceId).length,\n138:const keys = ['runId', 'repo', 'taskId', 'cohort', 'comparisonPass', 'decision', 'costNanos', 'passed', 'errored', 'skipped', 'attempts', 'size', 'graphNodes', 'filesTouched', 'issueLength', 'filesNamed', 'textSource', 'signalSource', 'models', 'source'];\n144:  const chartRows = comparison ? comparison.summaries.map(row => ({ ...row, cohort: { A: 'A: top baseline', B: 'B: Tally v1', C: 'C: Tally v2' }[row.pass], tasks: row.outcomes })) : cohorts;\n152:  const caption = comparison ? 'Same tasks and pinned base; partial coverage is not a completed comparison. One repeat gives no spread.'\n153:    : 'Observed task executions; different repos, models and setup histories. Not a causal savings comparison.';\n154:  await writeFile(join(out, file), svg(title, comparison ? 310 : 390, body + `<text x=\"24\" y=\"${comparison ? 280 : 365}\">${caption}</text>`));\n156:if (comparison) {\n158:  const maximum = Math.max(...comparison.rows.flatMap(row => ['A', 'B', 'C'].map(pass => average(row[pass]) ?? 0)), 0.01);\n160:  const body = comparison.rows.map((row, index) => {\n168:  const height = 120 + comparison.rows.length * 72;\n179:  const points = rows.map(row => `<circle cx=\"${x0 + row[signal.key] / maxX * 330}\" cy=\"${y0 + 180 - row.costNanos / 1e9 / maxY * 165}\" r=\"4\" fill=\"${{ A: '#356bbb', B: '#ae4739', C: '#187d5b' }[row.comparisonPass] ?? '#187d5b'}\"><title>${escape(`${row.comparisonPass ?? ''} ${row.runId}/${row.taskId}, $${(row.costNanos / 1e9).toFixed(5)}`)}</title></circle>`).join('');\n182:await writeFile(join(out, 'size-cost.svg'), svg('Sizing signals versus completed-task estimated cost', 650, scatter + `<text x=\"24\" y=\"625\">${comparison ? 'A blue: baseline; B red: v1; C green: v2. Matched plan signals; repeats are not independent samples.' : 'Successful task executions only; small, selected sample. Text may be reconstructed from current issue bodies.'}</text>`));\n185:const outcomeCell = outcomes => outcomes.length ? outcomes.map(row => `$${(row.costNanos / 1e9).toFixed(5)} / ${row.passed ? 'passed' : row.skipped ? 'skipped' : row.errored ? 'error' : 'failed'} / ${row.attempts} attempts (${row.runId})`).join('<br>') : 'pending';\n186:const comparisonLines = comparison ? [\n187:  '## Three-Pass Comparison', '', `Plan measured ${comparison.measuredAt ?? 'date unavailable'}, pinned base ${comparison.baseCommit}. Signals source: ${comparisonDir}/mentor-comparison-plan-signals.json.`, '',\n189:  ...comparison.summaries.map(row => `| ${row.pass}: ${{ A: 'top-tier baseline', B: 'Tally v1 (priors)', C: 'Tally v2 (trace history)' }[row.pass]} | ${row.coveredTasks}/${row.plannedTasks} | ${row.outcomes} | ${row.meanCostUsd === null ? 'pending' : row.meanCostUsd.toFixed(5)} | ${row.successRate === null ? 'pending' : (row.successRate * 100).toFixed(1) + '%'} | ${row.outcomes ? row.attempts : 'pending'} |`), '',\n190:  '| Task | Size | Targets | Dependents | Graph nodes | Text chars | Named paths | A: cost/verdict/attempts | B: cost/verdict/attempts | C: cost/verdict/attempts |',\n192:  ...comparison.rows.map(row => `| ${row.taskId} | ${row.size} | ${row.filesTouched} | ${row.dependents ?? 'unmeasured'} | ${row.graphNodes ?? 'unmeasured'} | ${row.issueLength} | ${row.filesNamed} | ${outcomeCell(row.A)} | ${outcomeCell(row.B)} | ${outcomeCell(row.C)} |`), '',\n193:  '![Cost per comparison task](cost-by-routing.svg)', '', '![Pass rate per comparison pass](success-by-routing.svg)', '',\n194:  'Pass labels are explicit experiment assignments, not proof that history affected every route in C. Actual routing provenance remains in tasks.csv. Costs only come from matching real ledgers; plan signals never supply spend. Missing passes/tasks stay pending; partial coverage is not a completed comparison. No savings claim before all three passes cover the same tasks. A single repeat establishes no statistical spread.', '',\n195:  `Comparison join exclusions: ${comparison.excluded.length} (base/text/pass-label mismatches retained in results.json).`, '',\n203:  ...comparisonLines,\n204:  comparison ? '## Historical Audit (Not the Matched Comparison)' : '## Before and after', '',\n208:  ...(!comparison ? ['![Estimated cost by routing](cost-by-routing.svg)', '', '![Success rate by routing](success-by-routing.svg)', ''] : []),\n210:  'No v1/v2 savings claim or baseline comparison is valid until both have measured, matched tasks. Missing cohorts mean not measured, never zero cost or 0% success. Closed interrupted runs and skipped tasks stay in the denominator; zero spend on an unstarted task is not savings. Repeated issues across runs are not independent experiments.', '',\n214:  ...(comparison ? ['| Pass | Signal | Successful pairs | Pearson r | Spearman rho |', '|---|---|---:|---:|---:|',\n216:    'The size chart uses only comparison outcomes at the pinned base with measured plan signals, not unrelated historical tasks. Pooled correlations mix model prices; per-pass coefficients are also reported. Repeated tasks across passes are not independent observations. New target files and named context can make graph targets differ from literal file mentions.', ''] : []),\n218:  'Graph nodes and target-file counts come only from saved impact totals; missing historical graphs are not reconstructed or replaced with actual edited files. Current issue bodies are labelled current-issue, not run-start snapshots. Most historical successful tasks are small documentation changes; the planned five-task comparison broadens scope but remains a tiny single-repository sample. Model price, caching, setup and repository differences confound these correlations; do not use them to train or claim a general cost predictor.', '',\n220:  `Readback date: ${readback.retrievedAt ?? 'not performed'}. ${matched.length}/${attempts.length} attempt costs/outcomes match a neatlogs history record by run, size, tier, result and integer cost.`,\n"},"started_at_ms":1791802721038,"completed_at_ms":1791802721038}}
{"timestamp":"2026-10-12T10:58:41.095Z","ordinal":15658,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a12fc3-c347-7401-a836-1e707400b955","call_id":"call_CgT4SBkZHKXfDbn8pI7Az9fo","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c35f26\",\"wall_time_seconds\":0.000005667,\"exit_code\":0,\"original_token_count\":29,\"output\":\"abc-backlog.yaml\\ncfoai-spend-fallback.csv\\ncomparison-pass.json\\nledger.json\\nplan-signals.json\\nrun.json\\ntally.yaml\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"35b559\",\"wall_time_seconds\":0.000004792,\"exit_code\":0,\"original_token_count\":1312,\"output\":\"---\\nname: using-ao\\ndescription: \\\"Catalog of the AO (Agent Orchestrator) `ao` CLI: spawning workers, managing sessions and projects, creating reusable Cues, sending messages, controlling the shared browser, previewing pages, and daemon control. Use when using the ao CLI, creating Cues, spawning workers, or managing AO sessions in an AO workspace.\\\"\\ntrigger: \\\"Using the ao CLI in an AO workspace: creating Cues, spawning workers, managing sessions/projects, sending messages, controlling or previewing pages.\\\"\\n---\\n\\n# AO CLI Catalog\\n\\n`ao` is a thin CLI over the local AO daemon. Every command is `ao <command> --help` for the authoritative flag list.\\n\\n| Command | What it does | When to use | Details |\\n|---|---|---|---|\\n| `spawn` | Spawn a project worker, orchestrator, or projectless standalone worker | Starting a new task or issue | [commands/spawn.md](commands/spawn.md) |\\n| `session` | Manage agent sessions (list, kill, rename, restore, etc.) | Inspecting or controlling running/terminated sessions | [commands/session.md](commands/session.md) |\\n| `agent` | Inspect installed harnesses and launch readiness | Choosing or diagnosing an agent harness | `ao agent ls --refresh` |\\n| `pr` | Merge a PR or resolve its review threads | Completing a reviewed change | `ao pr merge` / `ao pr resolve-comments` |\\n| `project` | Register, inspect, configure, or remove projects | Setting up or managing repos AO knows about | [commands/project.md](commands/project.md) |\\n| `automation` | Manage durable recurring session automations | Creating, editing, disabling, deleting, and inspecting scheduled runs | [commands/automation.md](commands/automation.md) |\\n| `cue` | Create or list reusable project Cues | Saving a repetitive command or agent task at the user's request | [commands/cue.md](commands/cue.md) |\\n| `orchestrator` | List orchestrator sessions | Viewing which sessions are orchestrators | [commands/orchestrator.md](commands/orchestrator.md) |\\n| `review` | Start, list, cancel, or submit AO's native reviewer for a worker's PR (default: this session) | Getting an adversarial review of an AO session's PR; never spawn a worker to review | [commands/review.md](commands/review.md) |\\n| `send` | Send a message to a running agent session | Correcting or directing a live agent | [commands/send.md](commands/send.md) |\\n| `report` | Persist a meaningful worker report | Checkpoints, blockers, decisions, outputs, and completion | [commands/report.md](commands/report.md) |\\n| `preview` | Start a session-owned app or open an exact URL/file | Running and showing the worker's relevant app, Markdown, HTML, PDF, or image | [commands/preview.md](commands/preview.md) |\\n| `render` | Show a self-contained HTML page inline in a chat thread | Answering with a chart, table, diagram, or mockup | [commands/render.md](commands/render.md) |\\n| `browser` | Inspect and control the session's shared live browser | Verifying a web app through snapshots, interactions, waits, screenshots, console, and errors | [commands/browser.md](commands/browser.md) |\\n| `start` | Fetch (if needed) and open the AO desktop app | Launching the app | [commands/start.md](commands/start.md) |\\n| `stop` | Stop the AO daemon | Shutting down AO | [commands/stop.md](commands/stop.md) |\\n| `status` | Show daemon status | Verifying the daemon is up and healthy | [commands/status.md](commands/status.md) |\\n| `doctor` | Run local health checks | Diagnosing AO setup problems | [commands/doctor.md](commands/doctor.md) |\\n| `import` | Import projects from a legacy AO install | Migrating from the old flat-file store | [commands/import.md](commands/import.md) |\\n| `version` | Print version information | Checking installed version | - |\\n| `completion` | Generate shell completion scripts | Setting up tab completion | - |\\n\\n## Conventions\\n\\n- Most read commands accept `--json` for machine-readable output.\\n- `-p / --project` scopes session subcommand lookups to one project.\\n- Session and project ids are shown by `ao session ls` and `ao project ls`.\\n- To refer to a session in AO Chat or the AO terminal, use the canonical in-app\\n  link `ao://sessions/{project-id}/{session-id}`. Read\\n  [commands/session.md](commands/session.md) for identity, encoding, and safety\\n  rules before constructing one.\\n- When the user asks to save a repeatable task as a Cue, use `ao cue list --json` to check existing definitions, then `ao cue create`. An agent Cue stores a reusable instruction; a command Cue stores an exact shell command. This agent-facing command can create and read Cues, but cannot edit or delete them. Direct the user to project settings for changes to existing Cues.\\n- `--agent` is an alias for `--harness` on `ao spawn`.\\n- Every command accepts `-h / --help` for the full flag list.\\n- For frontend launch, preview selection, or artifact handoff, read\\n  [commands/preview.md](commands/preview.md) before acting. Its static-file,\\n  project-runtime, and automatic-handoff rules are load-bearing.\\n- For page inspection, interaction, or request diagnosis, read\\n  [commands/browser.md](commands/browser.md). It defines shared-tab behavior\\n  and the opt-in network policy.\\n\\nUse [references.md](references.md) only when a natural-language request does\\nnot map clearly to a command above.\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"06ade9\",\"wall_time_seconds\":0.000005667,\"exit_code\":0,\"original_token_count\":1426,\"output\":\"import type { LedgerRow, RunState } from '../schema/types.js';\\n\\nexport type RoutingCohort = 'prior-only' | 'trace-driven' | 'local-history' | 'unattributed' | 'baseline';\\nexport interface TaskEvidence {\\n  runId: string;\\n  repo: string;\\n  taskId: string;\\n  cohort: RoutingCohort;\\n  decision: string | null;\\n  costNanos: number;\\n  passed: boolean;\\n  errored: boolean;\\n  skipped: boolean;\\n  attempts: number;\\n  size: string | null;\\n  graphNodes: number | null;\\n  filesTouched: number | null;\\n  issueLength: number | null;\\n  filesNamed: number | null;\\n  textSource: 'run-query' | 'current-issue' | 'plan-query' | 'missing';\\n  signalSource?: 'comparison-plan';\\n  comparisonPass?: 'A' | 'B' | 'C';\\n  models: string[];\\n  source: string;\\n}\\n\\nexport interface Correlation {\\n  n: number;\\n  pearson: number | null;\\n  spearman: number | null;\\n  interpretation: string;\\n}\\n\\nfunction pearson(pairs: [number, number][]): number | null {\\n  if (pairs.length < 3) return null;\\n  const meanX = pairs.reduce((s, [x]) => s + x, 0) / pairs.length;\\n  const meanY = pairs.reduce((s, [, y]) => s + y, 0) / pairs.length;\\n  let xx = 0, yy = 0, xy = 0;\\n  for (const [x, y] of pairs) { xx += (x - meanX) ** 2; yy += (y - meanY) ** 2; xy += (x - meanX) * (y - meanY); }\\n  return xx > 0 && yy > 0 ? xy / Math.sqrt(xx * yy) : null;\\n}\\n\\nfunction ranks(values: number[]): number[] {\\n  const sorted = [...values].sort((a, b) => a - b);\\n  const rank = new Map<number, number>();\\n  for (let i = 0; i < sorted.length;) {\\n    let j = i + 1;\\n    while (j < sorted.length && sorted[j] === sorted[i]) j++;\\n    rank.set(sorted[i]!, (i + j - 1) / 2 + 1); i = j;\\n  }\\n  return values.map(value => rank.get(value)!);\\n}\\n\\nexport function correlate(input: [number | null, number][]): Correlation {\\n  const pairs = input.filter((pair): pair is [number, number] => pair[0] !== null && Number.isFinite(pair[0]) && Number.isFinite(pair[1]));\\n  const p = pearson(pairs);\\n  const xs = ranks(pairs.map(([x]) => x)), ys = ranks(pairs.map(([, y]) => y));\\n  const s = pearson(xs.map((x, i) => [x, ys[i]!]));\\n  return {\\n    n: pairs.length, pearson: p, spearman: s,\\n    interpretation: p === null ? 'No estimable signal: fewer than 3 pairs or no variation.'\\n      : Math.abs(p) < 0.3 ? 'No clear linear signal in this sample.'\\n      : `${p > 0 ? 'Positive' : 'Negative'} association in this sample, not a causal or out-of-sample prediction.`,\\n  };\\n}\\n\\nfunction cohort(run: RunState, first?: LedgerRow): RoutingCohort {\\n  if (run.mode === 'baseline') return 'baseline';\\n  if (!first) return 'unattributed';\\n  const name = first.tier.replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, '\\\\\\\\$&');\\n  const selected = first.decision.split(';').find(part => new RegExp(`^\\\\\\\\s*${name} (?:neatlogs|local): \\\\\\\\d+ observations`).test(part));\\n  if (selected?.includes('neatlogs:') && selected.includes('observed statistics')) return 'trace-driven';\\n  if (selected?.includes('local:') && selected.includes('observed statistics')) return 'local-history';\\n  if (first.decision.includes(`No usable history exists for ${first.tier} on ${first.size}`)\\n    || new RegExp(`History has only \\\\\\\\d+ ${name} attempts? for ${first.size}, so it uses the prior`).test(first.decision)) return 'prior-only';\\n  return 'unattributed';\\n}\\n\\n/** Only closed real runs from an audited manifest; missing metrics remain missing. */\\nexport function taskEvidence(run: RunState, ledger: LedgerRow[], source: string,\\n  issues: Record<string, { title: string; body: string }> = {}): TaskEvidence[] {\\n  if (run.dryRun !== false || run.status === 'running') return [];\\n  const real = ledger.filter(row => row.runId === run.runId && row.costSource !== 'simulated');\\n  const result: TaskEvidence[] = [];\\n  for (const task of run.tasks) {\\n    const rows = real.filter(row => row.taskId === task.taskId).sort((a, b) => a.attempt - b.attempt);\\n    const attempts = rows.filter(row => !row.attemptId.endsWith(':handoff'));\\n    const skipped = !attempts.length && (task.status === 'skipped' || run.status === 'interrupted');\\n    if (!attempts.length && !skipped) continue;\\n    const first = attempts[0], last = attempts.at(-1);\\n    const issue = task.issueUrl ? issues[task.issueUrl] : undefined;\\n    const query = task.impact?.query || (issue ? `${issue.title}\\\\n${issue.body}` : null);\\n    const files = query?.match(/\\\\b(?:[\\\\w.-]+\\\\/)+[\\\\w.-]+\\\\.[A-Za-z0-9]+\\\\b/g);\\n    result.push({\\n      runId: run.runId, repo: run.repo, taskId: task.taskId, cohort: cohort(run, first), decision: first?.decision ?? null,\\n      costNanos: rows.reduce((sum, row) => sum + row.estimatedCostNanos, 0),\\n      passed: last?.result === 'passed', errored: last?.result === 'error', skipped, attempts: attempts.length,\\n      size: task.size, graphNodes: task.impact?.source === 'entire-graph' ? task.impact.totals.nodes : null,\\n      filesTouched: task.impact?.totals.filesTouched ?? null,\\n      issueLength: query?.length ?? null, filesNamed: query === null ? null : new Set(files ?? []).size,\\n      textSource: task.impact?.query ? 'run-query' : issue ? 'current-issue' : 'missing',\\n      models: [...new Set(attempts.map(row => row.model))], source,\\n    });\\n  }\\n  return result;\\n}\\n\\nexport function cohortSummary(tasks: TaskEvidence[], group: RoutingCohort) {\\n  const rows = tasks.filter(task => task.cohort === group);\\n  const spent = rows.reduce((sum, row) => sum + row.costNanos, 0);\\n  return { cohort: group, tasks: rows.length, passed: rows.filter(row => row.passed).length,\\n    errors: rows.filter(row => row.errored).length, skipped: rows.filter(row => row.skipped).length, totalCostUsd: spent / 1e9,\\n    meanCostUsd: rows.length ? spent / rows.length / 1e9 : null,\\n    successRate: rows.length ? rows.filter(row => row.passed).length / rows.length : null };\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"b59dd9\",\"wall_time_seconds\":0.000004666,\"exit_code\":0,\"original_token_count\":2153,\"output\":\"4:import { comparisonEvidence } from '../dist/agent/comparison-evidence.js';\\n11:if (args.includes('--help') || (!option('--manifest') && !option('--comparison-dir')) || !option('--out')) {\\n12:  console.log('Usage: npm run build, then node scripts/routing-evidence.mjs [--manifest runs.json] [--comparison-dir <folder>] --out <directory> [--issues issues.json] [--live-traces]');\\n19:const comparisonDir = option('--comparison-dir') ? resolve(option('--comparison-dir')) : null;\\n22:if (comparisonDir) {\\n23:  plan = JSON.parse(await readFile(join(comparisonDir, 'mentor-comparison-plan-signals.json'), 'utf8'));\\n25:  const passFile = option('--comparison-passes') ? resolve(option('--comparison-passes')) : join(comparisonDir, 'comparison-passes.json');\\n27:  catch (error) { if (error.code !== 'ENOENT' || option('--comparison-passes')) throw error; }\\n28:  if (!passes || typeof passes !== 'object' || Array.isArray(passes)) throw new Error('comparison-passes.json must be an A/B/C object');\\n30:    if (!['A', 'B', 'C'].includes(pass) || !Array.isArray(paths) || paths.some(path => typeof path !== 'string')) throw new Error('Comparison pass must be A/B/C with an array of run paths');\\n32:      const absolute = resolve(comparisonDir, path);\\n33:      if (passAssignments.has(absolute) && passAssignments.get(absolute) !== pass) throw new Error('One run path cannot belong to two comparison passes');\\n41:const seen = new Set(), tasks = [], attempts = [], exclusions = [], sources = [], closedRuns = [];\\n62:  attempts.push(...ledger.filter(row => row.runId === run.runId && row.costSource !== 'simulated' && !row.attemptId.endsWith(':handoff')));\\n64:const comparison = plan ? comparisonEvidence(plan, closedRuns) : null;\\n65:if (comparison) {\\n66:  for (const observation of comparison.observations) {\\n106:  for (const row of attempts) {\\n122:const eligible = (comparison ? comparison.observations : tasks).filter(task => task.passed && !task.errored);\\n127:const signalsByPass = comparison ? ['A', 'B', 'C'].flatMap(pass => signals.map(signal => ({ pass, key: signal.key, label: signal.label,\\n128:  ...correlate(eligible.filter(task => task.comparisonPass === pass).map(task => [task[signal.key], task.costNanos / 1e9])) }))) : [];\\n129:const matched = attempts.filter(row => readback.history.some(history => history.runId === row.runId && history.size === row.size\\n131:const reportData = { generatedAt: new Date().toISOString(), sources, exclusions, cohorts, signals, signalsByPass, comparison, tasks,\\n133:    verifiedWorkers: attempts.filter(row => readback.workers.some(worker => worker.attemptId === row.attemptId && worker.traceId === row.workerTraceId && worker.verified)).length,\\n134:    availableWorkerIds: attempts.filter(row => row.workerTraceId).length,\\n138:const keys = ['runId', 'repo', 'taskId', 'cohort', 'comparisonPass', 'decision', 'costNanos', 'passed', 'errored', 'skipped', 'attempts', 'size', 'graphNodes', 'filesTouched', 'issueLength', 'filesNamed', 'textSource', 'signalSource', 'models', 'source'];\\n144:  const chartRows = comparison ? comparison.summaries.map(row => ({ ...row, cohort: { A: 'A: top baseline', B: 'B: Tally v1', C: 'C: Tally v2' }[row.pass], tasks: row.outcomes })) : cohorts;\\n152:  const caption = comparison ? 'Same tasks and pinned base; partial coverage is not a completed comparison. One repeat gives no spread.'\\n153:    : 'Observed task executions; different repos, models and setup histories. Not a causal savings comparison.';\\n154:  await writeFile(join(out, file), svg(title, comparison ? 310 : 390, body + `<text x=\\\"24\\\" y=\\\"${comparison ? 280 : 365}\\\">${caption}</text>`));\\n156:if (comparison) {\\n158:  const maximum = Math.max(...comparison.rows.flatMap(row => ['A', 'B', 'C'].map(pass => average(row[pass]) ?? 0)), 0.01);\\n160:  const body = comparison.rows.map((row, index) => {\\n168:  const height = 120 + comparison.rows.length * 72;\\n179:  const points = rows.map(row => `<circle cx=\\\"${x0 + row[signal.key] / maxX * 330}\\\" cy=\\\"${y0 + 180 - row.costNanos / 1e9 / maxY * 165}\\\" r=\\\"4\\\" fill=\\\"${{ A: '#356bbb', B: '#ae4739', C: '#187d5b' }[row.comparisonPass] ?? '#187d5b'}\\\"><title>${escape(`${row.comparisonPass ?? ''} ${row.runId}/${row.taskId}, $${(row.costNanos / 1e9).toFixed(5)}`)}</title></circle>`).join('');\\n182:await writeFile(join(out, 'size-cost.svg'), svg('Sizing signals versus completed-task estimated cost', 650, scatter + `<text x=\\\"24\\\" y=\\\"625\\\">${comparison ? 'A blue: baseline; B red: v1; C green: v2. Matched plan signals; repeats are not independent samples.' : 'Successful task executions only; small, selected sample. Text may be reconstructed from current issue bodies.'}</text>`));\\n185:const outcomeCell = outcomes => outcomes.length ? outcomes.map(row => `$${(row.costNanos / 1e9).toFixed(5)} / ${row.passed ? 'passed' : row.skipped ? 'skipped' : row.errored ? 'error' : 'failed'} / ${row.attempts} attempts (${row.runId})`).join('<br>') : 'pending';\\n186:const comparisonLines = comparison ? [\\n187:  '## Three-Pass Comparison', '', `Plan measured ${comparison.measuredAt ?? 'date unavailable'}, pinned base ${comparison.baseCommit}. Signals source: ${comparisonDir}/mentor-comparison-plan-signals.json.`, '',\\n189:  ...comparison.summaries.map(row => `| ${row.pass}: ${{ A: 'top-tier baseline', B: 'Tally v1 (priors)', C: 'Tally v2 (trace history)' }[row.pass]} | ${row.coveredTasks}/${row.plannedTasks} | ${row.outcomes} | ${row.meanCostUsd === null ? 'pending' : row.meanCostUsd.toFixed(5)} | ${row.successRate === null ? 'pending' : (row.successRate * 100).toFixed(1) + '%'} | ${row.outcomes ? row.attempts : 'pending'} |`), '',\\n190:  '| Task | Size | Targets | Dependents | Graph nodes | Text chars | Named paths | A: cost/verdict/attempts | B: cost/verdict/attempts | C: cost/verdict/attempts |',\\n192:  ...comparison.rows.map(row => `| ${row.taskId} | ${row.size} | ${row.filesTouched} | ${row.dependents ?? 'unmeasured'} | ${row.graphNodes ?? 'unmeasured'} | ${row.issueLength} | ${row.filesNamed} | ${outcomeCell(row.A)} | ${outcomeCell(row.B)} | ${outcomeCell(row.C)} |`), '',\\n193:  '![Cost per comparison task](cost-by-routing.svg)', '', '![Pass rate per comparison pass](success-by-routing.svg)', '',\\n194:  'Pass labels are explicit experiment assignments, not proof that history affected every route in C. Actual routing provenance remains in tasks.csv. Costs only come from matching real ledgers; plan signals never supply spend. Missing passes/tasks stay pending; partial coverage is not a completed comparison. No savings claim before all three passes cover the same tasks. A single repeat establishes no statistical spread.', '',\\n195:  `Comparison join exclusions: ${comparison.excluded.length} (base/text/pass-label mismatches retained in results.json).`, '',\\n203:  ...comparisonLines,\\n204:  comparison ? '## Historical Audit (Not the Matched Comparison)' : '## Before and after', '',\\n208:  ...(!comparison ? ['![Estimated cost by routing](cost-by-routing.svg)', '', '![Success rate by routing](success-by-routing.svg)', ''] : []),\\n210:  'No v1/v2 savings claim or baseline comparison is valid until both have measured, matched tasks. Missing cohorts mean not measured, never zero cost or 0% success. Closed interrupted runs and skipped tasks stay in the denominator; zero spend on an unstarted task is not savings. Repeated issues across runs are not independent experiments.', '',\\n214:  ...(comparison ? ['| Pass | Signal | Successful pairs | Pearson r | Spearman rho |', '|---|---|---:|---:|---:|',\\n216:    'The size chart uses only comparison outcomes at the pinned base with measured plan signals, not unrelated historical tasks. Pooled correlations mix model prices; per-pass coefficients are also reported. Repeated tasks across passes are not independent observations. New target files and named context can make graph targets differ from literal file mentions.', ''] : []),\\n218:  'Graph nodes and target-file counts come only from saved impact totals; missing historical graphs are not reconstructed or replaced with actual edited files. Current issue bodies are labelled current-issue, not run-start snapshots. Most historical successful tasks are small documentation changes; the planned five-task comparison broadens scope but remains a tiny single-repository sample. Model price, caching, setup and repository differences confound these correlations; do not use them to train or claim a general cost predictor.', '',\\n220:  `Readback date: ${readback.retrievedAt ?? 'not performed'}. ${matched.length}/${attempts.length} attempt costs/outcomes match a neatlogs history record by run, size, tier, result and integer cost.`,\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a12fc0-e6ed-70d3-9280-cf68527cb68a","create_time":1791802721.095508}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
