{"timestamp":"2026-10-12T11:16:22.059Z","ordinal":15968,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a125af-5d46-7871-9bed-a128df2c2957","turn_id":"01a12fce-a573-76b3-a414-d175a23cff76","item":{"type":"CommandExecution","id":"exec-7884bf5c-e88c-49c0-ae0d-192561d65b59","process_id":"45997","command":["/bin/zsh","-lc","cat test/real-runs-guard.ts"],"cwd":"file:///Users/vaibhaav/.ao/data/worktrees/neatlogs-hack/neatlogs-hack-5","parsed_cmd":[{"type":"read","cmd":"cat test/real-runs-guard.ts","name":"real-runs-guard.ts","path":"test/real-runs-guard.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"import { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';\nimport { join, relative, resolve } from 'node:path';\nimport { afterAll, beforeAll } from 'vitest';\n\nconst protectedRunsDir = resolve(process.cwd(), '.tally/runs');\n\nfunction fingerprint(path: string): string {\n  const hash = createHash('sha256');\n\n  function visit(current: string): void {\n    if (!existsSync(current)) return;\n    const stat = statSync(current);\n    const name = relative(path, current) || '.';\n    if (stat.isDirectory()) {\n      hash.update(`dir:${name}\\n`);\n      for (const entry of readdirSync(current).sort()) visit(join(current, entry));\n      return;\n    }\n    if (stat.isFile()) {\n      hash.update(`file:${name}:${stat.size}:`);\n      hash.update(readFileSync(current));\n      hash.update('\\n');\n    }\n  }\n\n  visit(path);\n  return hash.digest('hex');\n}\n\nlet beforeFingerprint = '';\n\nbeforeAll(() => {\n  beforeFingerprint = fingerprint(protectedRunsDir);\n});\n\nafterAll(() => {\n  const afterFingerprint = fingerprint(protectedRunsDir);\n  if (afterFingerprint !== beforeFingerprint) {\n    throw new Error('Tests must not create, modify, or mirror data into workspace .tally/runs. Use a temp outputDir and latestRunDir.');\n  }\n});\n","stderr":"","aggregated_output":"import { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';\nimport { join, relative, resolve } from 'node:path';\nimport { afterAll, beforeAll } from 'vitest';\n\nconst protectedRunsDir = resolve(process.cwd(), '.tally/runs');\n\nfunction fingerprint(path: string): string {\n  const hash = createHash('sha256');\n\n  function visit(current: string): void {\n    if (!existsSync(current)) return;\n    const stat = statSync(current);\n    const name = relative(path, current) || '.';\n    if (stat.isDirectory()) {\n      hash.update(`dir:${name}\\n`);\n      for (const entry of readdirSync(current).sort()) visit(join(current, entry));\n      return;\n    }\n    if (stat.isFile()) {\n      hash.update(`file:${name}:${stat.size}:`);\n      hash.update(readFileSync(current));\n      hash.update('\\n');\n    }\n  }\n\n  visit(path);\n  return hash.digest('hex');\n}\n\nlet beforeFingerprint = '';\n\nbeforeAll(() => {\n  beforeFingerprint = fingerprint(protectedRunsDir);\n});\n\nafterAll(() => {\n  const afterFingerprint = fingerprint(protectedRunsDir);\n  if (afterFingerprint !== beforeFingerprint) {\n    throw new Error('Tests must not create, modify, or mirror data into workspace .tally/runs. Use a temp outputDir and latestRunDir.');\n  }\n});\n","exit_code":0,"duration":{"secs":0,"nanos":13917},"formatted_output":"import { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';\nimport { join, relative, resolve } from 'node:path';\nimport { afterAll, beforeAll } from 'vitest';\n\nconst protectedRunsDir = resolve(process.cwd(), '.tally/runs');\n\nfunction fingerprint(path: string): string {\n  const hash = createHash('sha256');\n\n  function visit(current: string): void {\n    if (!existsSync(current)) return;\n    const stat = statSync(current);\n    const name = relative(path, current) || '.';\n    if (stat.isDirectory()) {\n      hash.update(`dir:${name}\\n`);\n      for (const entry of readdirSync(current).sort()) visit(join(current, entry));\n      return;\n    }\n    if (stat.isFile()) {\n      hash.update(`file:${name}:${stat.size}:`);\n      hash.update(readFileSync(current));\n      hash.update('\\n');\n    }\n  }\n\n  visit(path);\n  return hash.digest('hex');\n}\n\nlet beforeFingerprint = '';\n\nbeforeAll(() => {\n  beforeFingerprint = fingerprint(protectedRunsDir);\n});\n\nafterAll(() => {\n  const afterFingerprint = fingerprint(protectedRunsDir);\n  if (afterFingerprint !== beforeFingerprint) {\n    throw new Error('Tests must not create, modify, or mirror data into workspace .tally/runs. Use a temp outputDir and latestRunDir.');\n  }\n});\n"},"started_at_ms":1791803782059,"completed_at_ms":1791803782059}}
