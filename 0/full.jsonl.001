{"timestamp":"2026-10-12T12:50:38.775Z","ordinal":23863,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a129b0-6007-7bd2-a48b-906c7b0f50e6","turn_id":"01a1300b-17e6-7e20-bf7a-c9594d868dc3","item":{"type":"CommandExecution","id":"exec-86544a16-deec-429b-91f2-b2bc0f70f3b3","process_id":"58197","command":["/usr/bin/zsh","-lc","sed -n '270,325p' adapters/cfoai.test.ts"],"cwd":"file:///tmp/tally-final-onboarding-20261012","parsed_cmd":[{"type":"read","cmd":"sed -n '270,325p' adapters/cfoai.test.ts","name":"cfoai.test.ts","path":"adapters/cfoai.test.ts"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"  it('accepts already-satisfied no-op receipts only after verifying Agent spend and tier row read-backs', async () => {\n    const client = new FakeCfoaiClient();\n    client.editStatus = 'no_op';\n    client.editReason = 'already_satisfied';\n    for (const row of ['Tier spend - cheap', 'Tier spend - middle', 'Tier spend - top', 'Run spend - current', 'Run spend - cumulative']) client.values.set(row, 0);\n    const adapter = new CfoaiBudgetAdapter({ client, now });\n    await adapter.writeCumulativeActualSpend(0);\n    await adapter.writeSpendDetail({ attempts: [], cumulativeRunSpendNanos: 0 });\n    expect(adapter.status().status).toBe('ok');\n    const call = client.callTool.bind(client);\n    client.callTool = async (name, args) => name === 'edit_table_blocks' ? { structuredContent: { status: 'no_op', reason: 'already_satisfied' } } : call(name, args);\n    await expect(adapter.writeCumulativeActualSpend(1_000)).rejects.toThrow('read-back');\n    expect(adapter.status()).toMatchObject({ status: 'error', detail: expect.stringContaining('write failed:') });\n  });\n\n  it('rejects a write when cfo.ai does not apply the update', async () => {\n    const client = new FakeCfoaiClient();\n    client.editStatus = 'queued';\n    const adapter = new CfoaiBudgetAdapter({ client, now });\n\n    await expect(adapter.writeCumulativeActualSpend(usdToNanos(1))).rejects.toThrow(/did not apply/);\n  });\n\n  it('validates and writes one idempotent organization-scoped Ari report', async () => {\n    const client = new FakeCfoaiClient();\n    client.tools.push('edit_memory');\n    const adapter = new CfoaiBudgetAdapter({ client, now, config: { orgId: '103210', scenario: 'Tally E2E' } });\n    const document = { content: '# Tally attempt report', filename: 'tally-run-a-attempt-a.md',\n      tags: ['tally', 'tally-run-a'], metadata: { source: 'tally-agents' }, idempotencyKey: 'tally-attempt-stable' };\n    await adapter.publishTaskContext(document);\n    const write = client.calls.find(call => call.name === 'edit_memory');\n    expect(write?.args).toMatchObject({ org_id: '103210', scenario: 'Tally E2E', idempotency_key: 'tally-attempt-stable',\n      retain_document: { content: '# Tally attempt report', filename: 'tally-run-a-attempt-a.md', scope: 'organization', tags: ['tally', 'tally-run-a'] } });\n    expect(adapter.status()).toMatchObject({ status: 'ok', detail: expect.stringContaining('organization memory') });\n  });\n\n  it('refuses an enabled context write when the current cfo.ai tool schema is missing', async () => {\n    const client = new FakeCfoaiClient();\n    client.tools.push('edit_memory');\n    client.listTools = async () => ({ tools: client.tools.map(name => ({ name })) });\n    const adapter = new CfoaiBudgetAdapter({ client, now });\n    await expect(adapter.publishTaskContext({ content: 'report', filename: 'report.md', tags: ['tally'], metadata: {}, idempotencyKey: 'stable' })).rejects.toThrow(/input schema/);\n    expect(client.calls.some(call => call.name === 'edit_memory')).toBe(false);\n  });\n});\n\ndescribe('checkCfoaiConnection', () => {\n  it('prepares a refresh-token request for cached Tally OAuth tokens', () => {\n    const params = refreshTokenRequest({ access_token: 'redacted', refresh_token: 'refresh-redacted', token_type: 'Bearer' }, 'read write');\n    expect(params?.get('grant_type')).toBe('refresh_token');\n    expect(params?.get('refresh_token')).toBe('refresh-redacted');\n    expect(params?.get('scope')).toBe('read write');\n    expect(refreshTokenRequest({ access_token: 'redacted', token_type: 'Bearer' })).toBeUndefined();\n  });\n\n  it('uses Tally cached tokens and the cfo.ai MCP server, not another tool MCP list', async () => {\n","exit_code":0,"duration":{"secs":0,"nanos":7805}},"started_at_ms":1791809438775,"completed_at_ms":1791809438775}}
